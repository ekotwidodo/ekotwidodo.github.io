---
import PageLayout from '@/layouts/PageLayout.astro';
import ProjectCard from '@/components/project/ProjectCard.astro';
import { getAllProjects } from '@/utils/content';
import { siteConfig } from '@/config/site';

/**
 * Projects Page (/projects)
 * Portfolio showcase of enterprise applications, analytics dashboards, and automation frameworks.
 */
const pageConfig = siteConfig.pages.projects;
const projects = await getAllProjects();
const breadcrumbs = [{ name: pageConfig.menu_label || pageConfig.title || 'Projects' }];

// Collect distinct technologies
const allTechSet = new Set<string>();
projects.forEach((p) => {
  p.data.technologies.forEach((t) => allTechSet.add(t));
});
const allTechs = Array.from(allTechSet).sort();
---

<PageLayout
  title={pageConfig.meta_title || `${pageConfig.title} | ${siteConfig.name}`}
  description={pageConfig.meta_description || pageConfig.subtitle}
  pageTitle={pageConfig.title}
  pageSubtitle={pageConfig.subtitle}
  breadcrumbs={breadcrumbs}
>
  <div class="space-y-8">
    <!-- Tech Filter Bar -->
    <div class="flex flex-wrap items-center gap-2 border-b border-slate-200/80 pb-4 dark:border-slate-800/80">
      <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 mr-2">Filter Technology:</span>
      <button
        type="button"
        data-tech="all"
        class="tech-filter-btn rounded-lg bg-primary-600 px-3 py-1 text-xs font-semibold text-white shadow-xs"
      >
        All ({projects.length})
      </button>
      {
        allTechs.map((tech) => (
          <button
            type="button"
            data-tech={tech}
            class="tech-filter-btn rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800"
          >
            {tech}
          </button>
        ))
      }
    </div>

    <!-- Projects Grid -->
    <div id="projects-grid" class="grid grid-cols-1 gap-6 md:grid-cols-2 items-stretch">
      {
        projects.length > 0 ? (
          projects.map((project) => (
            <div class="project-item flex flex-col h-full" data-techs={project.data.technologies.join(',')}>
              <ProjectCard project={project} className="h-full" />
            </div>
          ))
        ) : (
          <div class="col-span-full rounded-2xl border border-dashed border-slate-200 bg-white/50 p-12 text-center dark:border-slate-800 dark:bg-slate-900/30">
            <svg class="mx-auto h-10 w-10 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            <h3 class="mt-3 text-sm font-semibold text-slate-800 dark:text-slate-200">No projects published yet</h3>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Newly published projects will appear here.</p>
          </div>
        )
      }
    </div>
  </div>
</PageLayout>

<script>
  function setupProjectFilters() {
    const buttons = document.querySelectorAll('.tech-filter-btn');
    const items = document.querySelectorAll('.project-item');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tech = btn.getAttribute('data-tech');

        buttons.forEach((b) => {
          b.classList.remove('bg-primary-600', 'text-white', 'shadow-xs');
          b.classList.add('border', 'border-slate-200', 'bg-white', 'text-slate-700', 'dark:border-slate-800', 'dark:bg-slate-900', 'dark:text-slate-300');
        });

        btn.classList.remove('border', 'border-slate-200', 'bg-white', 'text-slate-700', 'dark:border-slate-800', 'dark:bg-slate-900', 'dark:text-slate-300');
        btn.classList.add('bg-primary-600', 'text-white', 'shadow-xs');

        items.forEach((item) => {
          const el = item as HTMLElement;
          const techs = (el.dataset.techs || '').split(',');
          if (tech === 'all' || techs.includes(tech || '')) {
            el.classList.remove('hidden');
            el.classList.add('flex');
          } else {
            el.classList.add('hidden');
            el.classList.remove('flex');
          }
        });
      });
    });
  }

  setupProjectFilters();
  document.addEventListener('astro:after-swap', setupProjectFilters);
</script>
