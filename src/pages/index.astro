---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/article/ArticleCard.astro';
import SectionHeader from '@/components/common/SectionHeader.astro';
import Pagination from '@/components/common/Pagination.astro';
import Button from '@/components/common/Button.astro';
import GraphCanvas from '@/components/common/GraphCanvas.astro';
import { siteConfig } from '@/config/site';
import { getAllArticles } from '@/utils/content';

/**
 * Home Page (/)
 * Front page featuring the Hero section with circular avatar and typing effect,
 * and exclusively displaying the Latest Articles with pagination.
 */
const articles = await getAllArticles();

const itemsPerPage = siteConfig.pagination.articlesPerPage;
const totalPages = Math.ceil(articles.length / itemsPerPage);
const currentPage = 1;
const paginatedArticles = articles.slice(0, itemsPerPage);
const homeConfig = siteConfig.pages.home;
---

<BaseLayout>
  <!-- Hero Section: Dark Navy saat light mode, Cerah/Light saat dark mode -->
  <section class="relative overflow-hidden border-b border-slate-800/90 bg-slate-900 text-white py-12 sm:py-16 lg:py-20 dark:border-slate-300/80 dark:bg-slate-100 dark:text-slate-900 transition-colors">
    <!-- Interactive Knowledge Graph background canvas (mouse hover responsive & lightweight) -->
    <GraphCanvas />

    <!-- Ambient subtle glow behind hero -->
    <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-blue-600/15 via-slate-900/60 to-slate-900 dark:from-blue-100/40 dark:via-slate-100/70 dark:to-slate-100"></div>
    <div class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col-reverse items-center gap-10 md:flex-row md:items-center md:justify-between">
        <!-- Hero Information -->
        <div class="flex-1 text-center md:text-left">
          <!-- Dynamic Typing Title with clean contrast -->
          <h1 class="text-3xl font-extrabold tracking-tight text-white dark:text-slate-900 sm:text-4xl lg:text-5xl min-h-[1.25em]">
            <span>{homeConfig.greeting || "Hi, I'm"} </span>
            <span
              id="typewriter-text"
              class="text-blue-400 dark:text-blue-600"
              data-words={JSON.stringify(homeConfig.typewriter_strings || [siteConfig.author.name])}
            >{siteConfig.author.name}</span><span id="typewriter-cursor" class="text-blue-400 dark:text-blue-600 font-light animate-pulse ml-0.5">|</span>
          </h1>

          <p class="mt-3 text-lg font-medium text-slate-200 dark:text-slate-800">
            {siteConfig.author.title}
          </p>

          <p class="mt-1.5 text-xs font-mono text-slate-400 dark:text-slate-500">
            {siteConfig.author.affiliation} &bull; {siteConfig.author.location}
          </p>

          <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-300 dark:text-slate-600">
            {siteConfig.author.bio}
          </p>

          <!-- Quick Navigation Actions (Standard Button Pakem) -->
          <div class="mt-7 flex flex-wrap items-center justify-center gap-3 md:justify-start">
            {
              siteConfig.menu.archives && (
                <Button
                  variant="primary"
                  size="md"
                  href="/archives"
                >
                  <span>Browse Articles</span>
                  <span class="opacity-80">&rarr;</span>
                </Button>
              )
            }
            {
              siteConfig.menu.about && (
                <Button
                  variant="outline"
                  size="md"
                  href="/about"
                >
                  <span>About This Portal</span>
                </Button>
              )
            }
          </div>
        </div>

        <!-- Circular Profile Image (Bulat) with elegant clean frame -->
        <div class="relative shrink-0">
          <div class="h-44 w-44 sm:h-52 sm:w-52 rounded-full border-2 border-slate-700/90 p-1 shadow-lg bg-slate-800 ring-4 ring-blue-500/10 dark:border-slate-300 dark:bg-white dark:ring-blue-500/20">
            <div class="h-full w-full overflow-hidden rounded-full bg-slate-900 dark:bg-slate-100">
              <img
                src={siteConfig.author.avatar}
                alt={siteConfig.author.name}
                class="h-full w-full object-cover object-top"
                width="208"
                height="208"
                loading="eager"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Content Container: Exclusively Latest Articles Section -->
  <div class="mx-auto max-w-6xl px-4 pt-8 pb-4 sm:px-6 sm:pt-10 sm:pb-6 lg:px-8">
    <section>
      <SectionHeader
        title={homeConfig.articles_title || 'Latest Articles'}
        subtitle={homeConfig.articles_subtitle || ''}
        actionText="View All Archives"
        actionHref="/archives"
      />

      <div class="mt-6 grid grid-cols-1 gap-6">
        {
          paginatedArticles.length > 0 ? (
            paginatedArticles.map((article) => (
              <ArticleCard article={article} />
            ))
          ) : (
            <div class="rounded-2xl border border-dashed border-slate-200 bg-white/50 p-12 text-center dark:border-slate-800 dark:bg-slate-900/30">
              <svg class="mx-auto h-10 w-10 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
              </svg>
              <h3 class="mt-3 text-sm font-semibold text-slate-800 dark:text-slate-200">No articles published yet</h3>
              <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Newly published articles will appear here.</p>
            </div>
          )
        }
      </div>

      <!-- Pagination Controls (5 articles per page as per PRD) -->
      <Pagination
        currentPage={currentPage}
        totalPages={totalPages}
        baseUrl=""
      />
    </section>
  </div>
</BaseLayout>

<script>
  /**
   * Lightweight, smooth typewriter effect for hero title
   * Rotates through author name, role, and expertise naturally.
   */
  function setupTypewriter() {
    const el = document.getElementById('typewriter-text');
    if (!el) return;

    // Respect user's motion preferences
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    let words: string[] = [];
    try {
      const dataWords = el.getAttribute('data-words');
      if (dataWords) {
        words = JSON.parse(dataWords);
      }
    } catch {
      // fallback
    }

    if (!words || words.length === 0) {
      words = [el.textContent || ''];
    }

    let wordIndex = 0;
    let charIndex = words[0].length;
    let isDeleting = false;

    const tick = () => {
      if (!el) return;

      const currentWord = words[wordIndex];

      if (isDeleting) {
        charIndex--;
        el.textContent = currentWord.substring(0, charIndex);
      } else {
        charIndex++;
        el.textContent = currentWord.substring(0, charIndex);
      }

      let speed = isDeleting ? 40 : 90;

      if (!isDeleting && charIndex === currentWord.length) {
        // Finished typing current word, pause before deleting
        speed = 2200;
        isDeleting = true;
      } else if (isDeleting && charIndex === 0) {
        // Finished deleting, move to next word
        isDeleting = false;
        wordIndex = (wordIndex + 1) % words.length;
        speed = 400;
      }

      setTimeout(tick, speed);
    };

    // Start rotation after initial pause
    setTimeout(() => {
      isDeleting = true;
      tick();
    }, 2000);
  }

  setupTypewriter();
  document.addEventListener('astro:after-swap', setupTypewriter);
</script>
