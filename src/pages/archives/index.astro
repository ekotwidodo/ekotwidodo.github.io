---
import PageLayout from '@/layouts/PageLayout.astro';
import Badge from '@/components/common/Badge.astro';
import { formatDate } from '@/utils/date';
import { calculateReadingTime } from '@/utils/readingTime';
import {
  getAllArticles,
  getAllArticleYears,
  getAllCategories,
  getAllTags
} from '@/utils/content';
import { siteConfig } from '@/config/site';

/**
 * Archives Page (/archives)
 * Comprehensive article archive with client-side interactive filtering by Year, Category, Tags, and Search.
 */
const pageConfig = siteConfig.pages.archives;
const articles = await getAllArticles();
const years = await getAllArticleYears();
const categories = await getAllCategories();
const tags = await getAllTags();

const breadcrumbs = [{ name: pageConfig.menu_label || pageConfig.title || 'Archives' }];
const articlesPerPage = siteConfig.pagination.articlesPerPage || 5;

// Prepare normalized article payload for instant client filtering
const archiveData = articles.map((a) => ({
  id: a.id,
  slug: a.id.replace(/\.(md|mdx)$/, ''),
  title: a.data.title,
  summary: a.data.summary,
  category: a.data.category,
  image: a.data.image || siteConfig.logo || '/logo.png',
  tags: a.data.tags,
  date: a.data.date.toISOString(),
  formattedDate: formatDate(a.data.date),
  year: new Date(a.data.date).getFullYear(),
  month: new Date(a.data.date).toLocaleDateString('en-US', { month: 'long' }),
  readingTime: calculateReadingTime(a.body || ''),
  series: a.data.series || null,
  featured: a.data.featured || false
}));

function getCategoryColor(category: string): 'purple' | 'indigo' | 'emerald' | 'amber' | 'teal' | 'info' | 'primary' {
  const cat = category.toLowerCase();
  if (cat.includes('artificial') || cat.includes('ai')) return 'purple';
  if (cat.includes('knowledge')) return 'indigo';
  if (cat.includes('data')) return 'emerald';
  if (cat.includes('software') || cat.includes('testing')) return 'amber';
  if (cat.includes('semantic')) return 'teal';
  if (cat.includes('web')) return 'info';
  return 'primary';
}
---

<PageLayout
  title={pageConfig.meta_title || `${pageConfig.title} | ${siteConfig.name}`}
  description={pageConfig.meta_description || pageConfig.subtitle}
  pageTitle={pageConfig.title}
  pageSubtitle={pageConfig.subtitle}
  breadcrumbs={breadcrumbs}
>
  <div class="space-y-8">
    <!-- Filter Controls Card -->
    <div class="rounded-xl border border-slate-200/90 bg-white p-5 shadow-xs dark:border-slate-800/90 dark:bg-slate-900/80">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <!-- Search Input -->
        <div>
          <label for="search-input" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">
            Search Keyword
          </label>
          <div class="relative">
            <input
              type="text"
              id="search-input"
              placeholder="Search title, content..."
              class="w-full rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2 text-xs text-slate-900 placeholder:text-slate-400 focus:border-primary-500 focus:bg-white focus:outline-none focus:ring-1 focus:ring-primary-500 dark:border-slate-800 dark:bg-slate-950 dark:text-white dark:focus:bg-slate-900"
            />
          </div>
        </div>

        <!-- Year Filter -->
        <div>
          <label for="year-select" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">
            Year
          </label>
          <select
            id="year-select"
            class="w-full rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2 text-xs text-slate-900 focus:border-primary-500 focus:bg-white focus:outline-none focus:ring-1 focus:ring-primary-500 dark:border-slate-800 dark:bg-slate-950 dark:text-white dark:focus:bg-slate-900"
          >
            <option value="">All Years</option>
            {years.map((y) => <option value={y}>{y}</option>)}
          </select>
        </div>

        <!-- Category Filter -->
        <div>
          <label for="category-select" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">
            Category
          </label>
          <select
            id="category-select"
            class="w-full rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2 text-xs text-slate-900 focus:border-primary-500 focus:bg-white focus:outline-none focus:ring-1 focus:ring-primary-500 dark:border-slate-800 dark:bg-slate-950 dark:text-white dark:focus:bg-slate-900"
          >
            <option value="">All Categories</option>
            {categories.map((c) => <option value={c}>{c}</option>)}
          </select>
        </div>

        <!-- Tag Filter -->
        <div>
          <label for="tag-select" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">
            Tag
          </label>
          <select
            id="tag-select"
            class="w-full rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2 text-xs text-slate-900 focus:border-primary-500 focus:bg-white focus:outline-none focus:ring-1 focus:ring-primary-500 dark:border-slate-800 dark:bg-slate-950 dark:text-white dark:focus:bg-slate-900"
          >
            <option value="">All Tags</option>
            {tags.map((t) => <option value={t}>#{t}</option>)}
          </select>
        </div>
      </div>

      <!-- Tag Quick Pills & Reset Action -->
      <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-3 dark:border-slate-800/60">
        <div class="flex flex-wrap items-center gap-1.5 text-xs">
          <span class="text-slate-500 dark:text-slate-400 mr-1">Popular:</span>
          {
            tags.slice(0, 6).map((t) => (
              <button
                type="button"
                data-quick-tag={t}
                class="rounded-md border border-slate-200 bg-slate-50 px-2 py-0.5 text-xs text-slate-600 transition hover:border-primary-300 hover:text-primary-600 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-300 dark:hover:border-primary-700 dark:hover:text-primary-400"
              >
                #{t}
              </button>
            ))
          }
        </div>

        <button
          type="button"
          id="reset-filter-btn"
          class="text-xs font-semibold text-slate-500 hover:text-primary-600 transition-colors dark:text-slate-400 dark:hover:text-primary-400"
        >
          Reset Filters
        </button>
      </div>
    </div>

    <!-- Results Status Counter -->
    <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
      <span id="results-count">{archiveData.length === 0 ? '0 articles' : `Showing 1–${Math.min(articlesPerPage, archiveData.length)} of ${archiveData.length} articles`}</span>
    </div>

    <!-- Filterable Article Cards Container -->
    <div id="articles-container" class="grid grid-cols-1 gap-6" data-page-size={articlesPerPage}>
      {
        archiveData.map((article, index) => {
          const categoryVar = getCategoryColor(article.category);
          return (
            <article
              class={`article-item group relative flex flex-col-reverse sm:flex-row items-center sm:items-stretch justify-between gap-5 sm:gap-6 overflow-hidden rounded-xl border border-slate-200/90 bg-white p-5 sm:p-6 shadow-2xs transition-colors duration-200 hover:border-slate-400 hover:bg-slate-50/40 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-slate-600 dark:hover:bg-slate-900/90 ${index >= articlesPerPage ? 'hidden' : ''}`}
              data-title={article.title.toLowerCase()}
              data-summary={article.summary.toLowerCase()}
              data-year={article.year}
              data-category={article.category}
              data-tags={article.tags.join(',')}
            >
              <!-- Left content -->
              <div class="flex flex-1 flex-col justify-between w-full">
                <div>
                  <div class="flex flex-wrap items-center gap-2 text-xs font-mono text-slate-500 dark:text-slate-400">
                    <time datetime={article.date}>{article.formattedDate}</time>
                    <span class="text-slate-300 dark:text-slate-700">&bull;</span>
                    <span>{article.readingTime}</span>
                    <span class="text-slate-300 dark:text-slate-700">&bull;</span>
                    <Badge variant={categoryVar} size="sm">
                      {article.category}
                    </Badge>
                    {
                      article.series && (
                        <>
                          <span class="text-slate-300 dark:text-slate-700">&bull;</span>
                          <span class="inline-flex items-center gap-1 rounded-md bg-amber-50 px-2 py-0.5 text-[11px] font-semibold text-amber-800 border border-amber-200/80 dark:bg-amber-950/50 dark:text-amber-300 dark:border-amber-800/60">
                            <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                            </svg>
                            <span>{article.series.name} &bull; Part {article.series.part}</span>
                          </span>
                        </>
                      )
                    }
                  </div>

                  <h3 class="mt-2.5 text-lg font-bold text-slate-900 transition-colors group-hover:text-blue-600 sm:text-xl dark:text-white dark:group-hover:text-blue-400 leading-snug">
                    <a href={`/articles/${article.slug}`}>
                      <span class="absolute inset-0" aria-hidden="true" />
                      {article.title}
                    </a>
                  </h3>

                  <p class="mt-2 text-sm leading-relaxed text-slate-600 line-clamp-2 dark:text-slate-300">
                    {article.summary}
                  </p>
                </div>

                <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-3 dark:border-slate-800/60">
                  <div class="relative z-10 flex flex-wrap gap-1.5 font-mono">
                    {article.tags.map((tag, idx) => {
                      const tagVariants = ['neutral', 'teal', 'rose', 'indigo', 'amber'] as const;
                      const tagVar = tagVariants[idx % tagVariants.length];
                      return (
                        <Badge variant={tagVar} size="sm">
                          #{tag}
                        </Badge>
                      );
                    })}
                  </div>

                  <span class="inline-flex items-center gap-1 text-xs font-semibold text-slate-700 transition-colors group-hover:text-blue-600 dark:text-slate-300 dark:group-hover:text-blue-400">
                    <span>Read &rarr;</span>
                  </span>
                </div>
              </div>

              <!-- Right: Square thumbnail image -->
              <div class="relative shrink-0 w-full sm:w-auto flex justify-center">
                <div class="relative h-44 w-full sm:h-34 sm:w-34 aspect-square overflow-hidden rounded-lg border border-slate-200/80 bg-slate-100 shadow-2xs dark:border-slate-800 dark:bg-slate-800">
                  <img
                    src={article.image}
                    alt={article.title}
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-102"
                    width="136"
                    height="136"
                    loading="lazy"
                  />
                  {
                    article.featured && (
                      <span class="absolute top-1.5 left-1.5 inline-flex items-center gap-0.5 rounded-full bg-amber-500/90 px-1.5 py-0.5 text-[9px] font-bold text-white shadow-2xs backdrop-blur-xs">
                        ★ Featured
                      </span>
                    )
                  }
                </div>
              </div>
            </article>
          );
        })
      }
    </div>

    <!-- Pagination Navigation Controls -->
    <nav
      id="archive-pagination"
      class="flex items-center justify-center gap-1.5 pt-6 pb-2"
      aria-label="Archives Pagination Navigation"
    ></nav>

    <!-- Empty State -->
    <div
      id="empty-state"
      class={`${archiveData.length === 0 ? '' : 'hidden '}rounded-xl border border-dashed border-slate-300 p-12 text-center dark:border-slate-800`}
    >
      <svg class="mx-auto h-10 w-10 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <h3 class="mt-3 text-base font-semibold text-slate-900 dark:text-white">
        No articles found
      </h3>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
        Try adjusting your search criteria or resetting filters.
      </p>
    </div>
  </div>
</PageLayout>

<script>
  function setupArchiveFilter() {
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    const yearSelect = document.getElementById('year-select') as HTMLSelectElement | null;
    const categorySelect = document.getElementById('category-select') as HTMLSelectElement | null;
    const tagSelect = document.getElementById('tag-select') as HTMLSelectElement | null;
    const resetBtn = document.getElementById('reset-filter-btn');
    const resultsCount = document.getElementById('results-count');
    const emptyState = document.getElementById('empty-state');
    const articlesContainer = document.getElementById('articles-container');
    const paginationNav = document.getElementById('archive-pagination');
    const articles = document.querySelectorAll('.article-item');
    const quickTags = document.querySelectorAll('[data-quick-tag]');

    if (!articles.length) return;

    const pageSize = Number(articlesContainer?.dataset.pageSize) || 5;
    let currentPage = 1;

    // Check URL parameters on mount
    const urlParams = new URLSearchParams(window.location.search);
    const initialTag = urlParams.get('tag');
    const initialCategory = urlParams.get('category');
    const initialYear = urlParams.get('year');
    const initialSearch = urlParams.get('search');
    const pageParam = urlParams.get('page');

    if (initialTag && tagSelect) tagSelect.value = initialTag;
    if (initialCategory && categorySelect) categorySelect.value = initialCategory;
    if (initialYear && yearSelect) yearSelect.value = initialYear;
    if (initialSearch && searchInput) searchInput.value = initialSearch;
    if (pageParam) {
      const parsedPage = parseInt(pageParam, 10);
      if (!isNaN(parsedPage) && parsedPage > 0) {
        currentPage = parsedPage;
      }
    }

    const scrollToTop = () => {
      const target = document.getElementById('results-count') || articlesContainer;
      target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    const renderPagination = (totalPages: number) => {
      if (!paginationNav) return;

      if (totalPages <= 1) {
        paginationNav.innerHTML = '';
        paginationNav.classList.add('hidden');
        return;
      }

      paginationNav.classList.remove('hidden');
      paginationNav.innerHTML = '';

      // Previous Button
      const hasPrev = currentPage > 1;
      const prevElement = document.createElement(hasPrev ? 'button' : 'span');
      prevElement.className = hasPrev
        ? 'inline-flex h-9 items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50 hover:text-primary-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-primary-400 cursor-pointer'
        : 'inline-flex h-9 cursor-not-allowed items-center gap-1.5 rounded-lg border border-slate-100 bg-slate-50 px-3 text-sm font-medium text-slate-400 opacity-60 dark:border-slate-800/40 dark:bg-slate-900/40 dark:text-slate-600';
      prevElement.innerHTML = `
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <span>Previous</span>
      `;
      if (hasPrev) {
        prevElement.setAttribute('type', 'button');
        prevElement.addEventListener('click', () => {
          currentPage--;
          applyFilter(false);
          scrollToTop();
        });
      }
      paginationNav.appendChild(prevElement);

      // Numeric Page Buttons
      const numbersWrapper = document.createElement('div');
      numbersWrapper.className = 'hidden items-center gap-1 sm:flex';

      for (let i = 1; i <= totalPages; i++) {
        const isActive = i === currentPage;
        const pageBtn = document.createElement('button');
        pageBtn.type = 'button';
        pageBtn.className = `inline-flex h-9 w-9 items-center justify-center rounded-lg text-sm font-semibold transition cursor-pointer ${
          isActive
            ? 'bg-primary-600 text-white shadow-sm hover:bg-primary-700 dark:bg-primary-600 dark:hover:bg-primary-500'
            : 'border border-slate-200 bg-white text-slate-700 hover:bg-slate-50 hover:text-primary-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-primary-400'
        }`;
        pageBtn.textContent = String(i);
        if (isActive) {
          pageBtn.setAttribute('aria-current', 'page');
        }
        pageBtn.addEventListener('click', () => {
          if (currentPage !== i) {
            currentPage = i;
            applyFilter(false);
            scrollToTop();
          }
        });
        numbersWrapper.appendChild(pageBtn);
      }
      paginationNav.appendChild(numbersWrapper);

      // Mobile indicator
      const mobileIndicator = document.createElement('span');
      mobileIndicator.className = 'px-2 text-xs font-medium text-slate-500 sm:hidden dark:text-slate-400';
      mobileIndicator.textContent = `Page ${currentPage} of ${totalPages}`;
      paginationNav.appendChild(mobileIndicator);

      // Next Button
      const hasNext = currentPage < totalPages;
      const nextElement = document.createElement(hasNext ? 'button' : 'span');
      nextElement.className = hasNext
        ? 'inline-flex h-9 items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50 hover:text-primary-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-primary-400 cursor-pointer'
        : 'inline-flex h-9 cursor-not-allowed items-center gap-1.5 rounded-lg border border-slate-100 bg-slate-50 px-3 text-sm font-medium text-slate-400 opacity-60 dark:border-slate-800/40 dark:bg-slate-900/40 dark:text-slate-600';
      nextElement.innerHTML = `
        <span>Next</span>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      `;
      if (hasNext) {
        nextElement.setAttribute('type', 'button');
        nextElement.addEventListener('click', () => {
          currentPage++;
          applyFilter(false);
          scrollToTop();
        });
      }
      paginationNav.appendChild(nextElement);
    };

    const applyFilter = (resetPage = false) => {
      if (resetPage) {
        currentPage = 1;
      }

      const query = (searchInput?.value || '').trim().toLowerCase();
      const selectedYear = yearSelect?.value || '';
      const selectedCategory = categorySelect?.value || '';
      const selectedTag = tagSelect?.value || '';

      const matchedArticles: HTMLElement[] = [];

      articles.forEach((el) => {
        const item = el as HTMLElement;
        const title = item.dataset.title || '';
        const summary = item.dataset.summary || '';
        const year = item.dataset.year || '';
        const category = item.dataset.category || '';
        const tags = (item.dataset.tags || '').split(',');

        const matchQuery =
          !query || title.includes(query) || summary.includes(query) || tags.some((t) => t.toLowerCase().includes(query));
        const matchYear = !selectedYear || year === selectedYear;
        const matchCategory = !selectedCategory || category === selectedCategory;
        const matchTag = !selectedTag || tags.includes(selectedTag);

        if (matchQuery && matchYear && matchCategory && matchTag) {
          matchedArticles.push(item);
        } else {
          item.classList.add('hidden');
        }
      });

      const totalMatches = matchedArticles.length;
      const totalPages = Math.ceil(totalMatches / pageSize) || 1;

      if (currentPage > totalPages) {
        currentPage = 1;
      }

      const startIndex = (currentPage - 1) * pageSize;
      const endIndex = startIndex + pageSize;

      matchedArticles.forEach((item, index) => {
        if (index >= startIndex && index < endIndex) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });

      // Update URL query parameters without reloading
      const newUrl = new URL(window.location.href);
      if (currentPage > 1) {
        newUrl.searchParams.set('page', String(currentPage));
      } else {
        newUrl.searchParams.delete('page');
      }
      if (query) newUrl.searchParams.set('search', query); else newUrl.searchParams.delete('search');
      if (selectedYear) newUrl.searchParams.set('year', selectedYear); else newUrl.searchParams.delete('year');
      if (selectedCategory) newUrl.searchParams.set('category', selectedCategory); else newUrl.searchParams.delete('category');
      if (selectedTag) newUrl.searchParams.set('tag', selectedTag); else newUrl.searchParams.delete('tag');
      window.history.replaceState({}, '', newUrl.toString());

      // Update results count
      if (resultsCount) {
        if (totalMatches === 0) {
          resultsCount.textContent = 'Showing 0 articles';
        } else {
          const fromItem = startIndex + 1;
          const toItem = Math.min(endIndex, totalMatches);
          const filterSuffix = totalMatches < articles.length ? ` (filtered from ${articles.length})` : '';
          resultsCount.textContent = `Showing ${fromItem}–${toItem} of ${totalMatches} articles${filterSuffix}`;
        }
      }

      // Update empty state
      if (emptyState) {
        if (totalMatches === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }

      // Render pagination
      renderPagination(totalPages);
    };

    searchInput?.addEventListener('input', () => applyFilter(true));
    yearSelect?.addEventListener('change', () => applyFilter(true));
    categorySelect?.addEventListener('change', () => applyFilter(true));
    tagSelect?.addEventListener('change', () => applyFilter(true));

    quickTags.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = btn.getAttribute('data-quick-tag');
        if (tag && tagSelect) {
          tagSelect.value = tag;
          applyFilter(true);
        }
      });
    });

    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (yearSelect) yearSelect.value = '';
      if (categorySelect) categorySelect.value = '';
      if (tagSelect) tagSelect.value = '';
      applyFilter(true);
    });

    window.addEventListener('popstate', () => {
      const popParams = new URLSearchParams(window.location.search);
      const popPage = parseInt(popParams.get('page') || '1', 10);
      currentPage = !isNaN(popPage) && popPage > 0 ? popPage : 1;
      applyFilter(false);
    });

    applyFilter(false);
  }

  setupArchiveFilter();
  document.addEventListener('astro:after-swap', setupArchiveFilter);
</script>
