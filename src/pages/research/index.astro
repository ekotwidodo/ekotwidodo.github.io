---
import PageLayout from '@/layouts/PageLayout.astro';
import ResearchCard from '@/components/research/ResearchCard.astro';
import { getAllResearch } from '@/utils/content';
import { externalProfiles } from '@/config/navigation';
import { siteConfig } from '@/config/site';

/**
 * Research Page (/research)
 * Displays academic papers, theses, and conference contributions with status, DOI, and abstract.
 */
const pageConfig = siteConfig.pages.research;
const research = await getAllResearch();
const breadcrumbs = [{ name: pageConfig.menu_label || pageConfig.title || 'Research' }];

const scholarProfile = externalProfiles.find((p) => p.name.includes('Scholar'));
const rgProfile = externalProfiles.find((p) => p.name.includes('ResearchGate'));
---

<PageLayout
  title={pageConfig.meta_title || `${pageConfig.title} | ${siteConfig.name}`}
  description={pageConfig.meta_description || pageConfig.subtitle}
  pageTitle={pageConfig.title}
  pageSubtitle={pageConfig.subtitle}
  breadcrumbs={breadcrumbs}
>
  <div class="space-y-8">
    <!-- Academic Profiles Callout Banner -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 rounded-xl border border-primary-200/80 bg-primary-50/60 p-4 dark:border-primary-900/60 dark:bg-primary-950/40">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary-600 text-white shadow-xs">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>
        <div>
          <h2 class="text-sm font-bold text-slate-900 dark:text-white">
            Academic Profiles & Citation Indexes
          </h2>
          <p class="text-xs text-slate-600 dark:text-slate-400">
            Track citations, peer-reviewed indices, and preprints across academic networks.
          </p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        {
          scholarProfile && (
            <a
              href={scholarProfile.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-lg border border-primary-300 bg-white px-3 py-1.5 text-xs font-semibold text-primary-700 shadow-xs transition hover:bg-primary-50 dark:border-primary-800 dark:bg-slate-900 dark:text-primary-300 dark:hover:bg-primary-950"
            >
              <span>Google Scholar</span>
              <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          )
        }
        {
          rgProfile && (
            <a
              href={rgProfile.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-lg border border-primary-300 bg-white px-3 py-1.5 text-xs font-semibold text-primary-700 shadow-xs transition hover:bg-primary-50 dark:border-primary-800 dark:bg-slate-900 dark:text-primary-300 dark:hover:bg-primary-950"
            >
              <span>ResearchGate</span>
              <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          )
        }
      </div>
    </div>

    <!-- Filter Buttons (All, Completed, Ongoing) -->
    <div class="flex items-center gap-2 border-b border-slate-200/80 pb-3 dark:border-slate-800/80">
      <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 mr-2">Filter Status:</span>
      <button
        type="button"
        data-filter="all"
        class="filter-status-btn active-filter rounded-lg bg-primary-600 px-3 py-1 text-xs font-semibold text-white shadow-xs"
      >
        All ({research.length})
      </button>
      <button
        type="button"
        data-filter="completed"
        class="filter-status-btn rounded-lg border border-slate-200 bg-white px-3 py-1 text-xs font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800"
      >
        Completed ({research.filter((r) => r.data.status === 'completed').length})
      </button>
      <button
        type="button"
        data-filter="ongoing"
        class="filter-status-btn rounded-lg border border-slate-200 bg-white px-3 py-1 text-xs font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800"
      >
        Ongoing ({research.filter((r) => r.data.status === 'ongoing').length})
      </button>
    </div>

    <!-- Research Items Grid -->
    <div id="research-list" class="grid grid-cols-1 gap-6">
      {
        research.length > 0 ? (
          research.map((item) => (
            <div class="research-item" data-status={item.data.status}>
              <ResearchCard item={item} />
            </div>
          ))
        ) : (
          <div class="rounded-2xl border border-dashed border-slate-200 bg-white/50 p-12 text-center dark:border-slate-800 dark:bg-slate-900/30">
            <svg class="mx-auto h-10 w-10 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            <h3 class="mt-3 text-sm font-semibold text-slate-800 dark:text-slate-200">No research publications yet</h3>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Newly published research papers will appear here.</p>
          </div>
        )
      }
    </div>
  </div>
</PageLayout>

<script>
  function setupResearchFilters() {
    const buttons = document.querySelectorAll('.filter-status-btn');
    const items = document.querySelectorAll('.research-item');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Toggle active button style
        buttons.forEach((b) => {
          b.classList.remove('bg-primary-600', 'text-white', 'shadow-xs');
          b.classList.add('border', 'border-slate-200', 'bg-white', 'text-slate-700', 'dark:border-slate-800', 'dark:bg-slate-900', 'dark:text-slate-300');
        });

        btn.classList.remove('border', 'border-slate-200', 'bg-white', 'text-slate-700', 'dark:border-slate-800', 'dark:bg-slate-900', 'dark:text-slate-300');
        btn.classList.add('bg-primary-600', 'text-white', 'shadow-xs');

        items.forEach((item) => {
          const el = item as HTMLElement;
          const status = el.dataset.status;
          if (filter === 'all' || status === filter) {
            el.classList.remove('hidden');
          } else {
            el.classList.add('hidden');
          }
        });
      });
    });
  }

  setupResearchFilters();
  document.addEventListener('astro:after-swap', setupResearchFilters);
</script>
