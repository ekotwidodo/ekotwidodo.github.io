---
import { render } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import Badge from '@/components/common/Badge.astro';
import { getAboutProfile } from '@/utils/content';
import { siteConfig } from '@/config/site';

/**
 * Dedicated Curriculum Vitae (CV) Page (/cv)
 * Comprehensive professional career record, education, technical stack,
 * research outputs, awards, and printer-ready PDF styling.
 */
const profileEntry = await getAboutProfile();

if (!profileEntry) {
  throw new Error('About profile markdown document not found in src/content/about/');
}

const { Content } = await render(profileEntry);
const data = profileEntry.data;
const pageConfig = siteConfig.pages.cv;
const breadcrumbs = [{ name: 'About', href: '/about' }, { name: pageConfig.menu_label || pageConfig.title || 'CV' }];
const socials = siteConfig.author.socials;

const skillCategories = data.skillCategories || [];
const honorsAndAwards = data.honorsAndAwards || [];
const languages = data.languages || [];
const specializations = data.specializations || [];
---

<PageLayout
  title={pageConfig.meta_title || `${pageConfig.title} | ${siteConfig.name}`}
  description={pageConfig.meta_description || siteConfig.description}
  pageTitle={pageConfig.title}
  pageSubtitle={pageConfig.subtitle}
  breadcrumbs={breadcrumbs}
>
  <div class="space-y-10 cv-container">
    <!-- 1. CV Header & Profile Card -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-xs dark:border-slate-800/90 dark:bg-slate-900/80 transition-colors">
      <div class="flex flex-col md:flex-row items-center md:items-start gap-6 lg:gap-8">
        <!-- Circular Avatar with Gradient Ring -->
        <div class="relative shrink-0">
          <div class="flex h-28 w-28 sm:h-36 sm:w-36 items-center justify-center rounded-full p-1 bg-gradient-to-tr from-blue-600 via-indigo-600 to-sky-500 shadow-md">
            <img
              src={data.avatar || siteConfig.author.avatar}
              alt={data.name}
              class="h-full w-full rounded-full object-cover object-top ring-2 ring-white dark:ring-slate-900"
              width="144"
              height="144"
              loading="eager"
            />
          </div>
          <span class="absolute bottom-1 right-1 flex h-4.5 w-4.5 items-center justify-center rounded-full bg-emerald-500 ring-2 ring-white dark:ring-slate-900" title="Active & Open for Research Collaboration">
            <span class="h-2 w-2 rounded-full bg-white animate-pulse"></span>
          </span>
        </div>

        <!-- Personal Info & Header Details -->
        <div class="flex-1 text-center md:text-left space-y-3">
          <div>
            <div class="flex flex-wrap items-center justify-center md:justify-start gap-2.5">
              <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">
                {data.name}
              </h2>
              <span class="rounded-md bg-blue-50 px-2 py-0.5 text-xs font-semibold text-blue-700 dark:bg-blue-950/70 dark:text-blue-300 border border-blue-200/80 dark:border-blue-900/60">
                Curriculum Vitae
              </span>
            </div>
            <p class="mt-1 text-base sm:text-lg font-semibold text-blue-600 dark:text-blue-400">
              {data.title}
            </p>
            <p class="mt-1 text-xs sm:text-sm text-slate-600 dark:text-slate-400">
              {data.affiliation} &bull; {data.location}
            </p>
          </div>

          <!-- Status & Specialization Badges -->
          {
            specializations.length > 0 && (
              <div class="flex flex-wrap items-center justify-center md:justify-start gap-2">
                {specializations.map((spec, i) => {
                  const variants = ['info', 'primary', 'success', 'neutral'] as const;
                  return (
                    <Badge variant={variants[i % variants.length]} size="sm">
                      {spec}
                    </Badge>
                  );
                })}
              </div>
            )
          }

          <!-- Social Media Icons Bar -->
          <div class="pt-2 border-t border-slate-100 dark:border-slate-800/80">
            <div class="flex flex-wrap items-center justify-center md:justify-start gap-2">
              <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 mr-1 hidden sm:inline">
                Connect:
              </span>

              {
                socials.github && (
                  <a
                    href={socials.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex h-8.5 w-8.5 items-center justify-center rounded-lg border border-slate-200 bg-slate-50 text-slate-700 shadow-2xs transition-all hover:scale-105 hover:border-slate-800 hover:bg-slate-900 hover:text-white dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:border-slate-500 dark:hover:bg-white dark:hover:text-slate-900"
                    title="GitHub Profile"
                    aria-label="GitHub Profile"
                  >
                    <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                    </svg>
                  </a>
                )
              }

              {
                socials.linkedin && (
                  <a
                    href={socials.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex h-8.5 w-8.5 items-center justify-center rounded-lg border border-slate-200 bg-slate-50 text-slate-700 shadow-2xs transition-all hover:scale-105 hover:border-blue-600 hover:bg-blue-600 hover:text-white dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:border-blue-500 dark:hover:bg-blue-600 dark:hover:text-white"
                    title="LinkedIn Profile"
                    aria-label="LinkedIn Profile"
                  >
                    <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.64 1.64 0 1 0 0-3.28 1.64 1.64 0 0 0 0 3.28m1.4 9.74v-8.37H5.06v8.37h2.8z"/>
                    </svg>
                  </a>
                )
              }

              {
                socials.googleScholar && (
                  <a
                    href={socials.googleScholar}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex h-8.5 w-8.5 items-center justify-center rounded-lg border border-slate-200 bg-slate-50 text-slate-700 shadow-2xs transition-all hover:scale-105 hover:border-blue-500 hover:bg-blue-500 hover:text-white dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:border-blue-400 dark:hover:bg-blue-500 dark:hover:text-white"
                    title="Google Scholar Citations"
                    aria-label="Google Scholar Citations"
                  >
                    <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 9a8 8 0 0 1 7.162 4.44L24 9.5 12 0z"/>
                    </svg>
                  </a>
                )
              }

              {
                socials.medium && (
                  <a
                    href={socials.medium}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex h-8.5 w-8.5 items-center justify-center rounded-lg border border-slate-200 bg-slate-50 text-slate-700 shadow-2xs transition-all hover:scale-105 hover:border-slate-900 hover:bg-slate-900 hover:text-white dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:border-slate-400 dark:hover:bg-white dark:hover:text-slate-900"
                    title="Medium Publications"
                    aria-label="Medium Publications"
                  >
                    <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M13.54 12a6.8 6.8 0 0 1-6.77 6.82A6.8 6.8 0 0 1 0 12a6.8 6.8 0 0 1 13.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/>
                    </svg>
                  </a>
                )
              }

              {
                socials.x && (
                  <a
                    href={socials.x}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex h-8.5 w-8.5 items-center justify-center rounded-lg border border-slate-200 bg-slate-50 text-slate-700 shadow-2xs transition-all hover:scale-105 hover:border-slate-900 hover:bg-slate-900 hover:text-white dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:border-slate-400 dark:hover:bg-white dark:hover:text-slate-900"
                    title="X / Twitter"
                    aria-label="X / Twitter"
                  >
                    <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                    </svg>
                  </a>
                )
              }
            </div>
          </div>
        </div>

        <!-- Quick Action Buttons: Print CV & Contact (Hidden on Print) -->
        <div class="shrink-0 flex flex-row md:flex-col gap-2.5 print:hidden w-full md:w-auto">
          <button
            type="button"
            id="print-cv-btn"
            class="flex-1 md:flex-none inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-4 py-2 text-xs font-semibold text-slate-800 shadow-2xs transition-all hover:bg-slate-100 hover:border-slate-300 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
            title="Print or Save CV as PDF"
          >
            <svg class="h-4 w-4 text-slate-600 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4H7v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            <span>Print / Save CV</span>
          </button>

          <a
            href="/contact"
            class="flex-1 md:flex-none inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-4 py-2 text-xs font-semibold text-white shadow-2xs transition-all hover:bg-blue-500 dark:hover:bg-blue-700"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
            <span>Get in Touch</span>
          </a>
        </div>
      </div>
    </div>

    <!-- 2. Executive Biography & Professional Summary -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-xs dark:border-slate-800/90 dark:bg-slate-900/80 transition-colors">
      <div class="flex items-center gap-3 border-b border-slate-100 pb-4 dark:border-slate-800/60">
        <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-50 text-blue-600 dark:bg-blue-950/70 dark:text-blue-400">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </div>
        <div>
          <h3 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
            Executive Summary
          </h3>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            Professional background, work ethic, and technical orientation.
          </p>
        </div>
      </div>

      <div class="prose-content pt-5 text-sm sm:text-base leading-relaxed text-slate-700 dark:text-slate-300">
        <Content />
      </div>
    </div>

    <!-- 3. Professional Work Experience (Timeline CV) -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-xs dark:border-slate-800/90 dark:bg-slate-900/80 transition-colors">
      <div class="flex items-center gap-3 border-b border-slate-100 pb-4 dark:border-slate-800/60">
        <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600 dark:bg-indigo-950/70 dark:text-indigo-400">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <div>
          <h3 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
            Professional Experience
          </h3>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            Career timeline, engineering leadership, and institutional contributions.
          </p>
        </div>
      </div>

      <div class="mt-6 space-y-8">
        {
          data.experience.map((exp) => (
            <div class="relative pl-7 sm:pl-8 border-l-2 border-blue-500/80 dark:border-blue-500">
              <span class="absolute -left-2 top-1 h-3.5 w-3.5 rounded-full bg-blue-600 ring-4 ring-white dark:ring-slate-900" />
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
                <h4 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">
                  {exp.position}
                </h4>
                <span class="inline-flex items-center self-start sm:self-auto rounded-md bg-blue-50 px-2.5 py-0.5 text-xs font-semibold text-blue-700 dark:bg-blue-950/70 dark:text-blue-300 border border-blue-200/60 dark:border-blue-900/50">
                  {exp.period}
                </span>
              </div>
              <p class="mt-0.5 text-sm font-semibold text-blue-600 dark:text-blue-400">
                {exp.company}
              </p>
              {
                exp.description && (
                  <p class="mt-2.5 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
                    {exp.description}
                  </p>
                )
              }
            </div>
          ))
        }
      </div>
    </div>

    <!-- 4. Education & Academic Background (Timeline CV) -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-xs dark:border-slate-800/90 dark:bg-slate-900/80 transition-colors">
      <div class="flex items-center gap-3 border-b border-slate-100 pb-4 dark:border-slate-800/60">
        <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600 dark:bg-emerald-950/70 dark:text-emerald-400">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path d="M12 14l9-5-9-5-9 5 9 5z" />
            <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
          </svg>
        </div>
        <div>
          <h3 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
            Education & Academic Training
          </h3>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            Graduate and undergraduate degree credentials.
          </p>
        </div>
      </div>

      <div class="mt-6 space-y-8">
        {
          data.education.map((edu) => (
            <div class="relative pl-7 sm:pl-8 border-l-2 border-emerald-500/80 dark:border-emerald-500">
              <span class="absolute -left-2 top-1 h-3.5 w-3.5 rounded-full bg-emerald-600 ring-4 ring-white dark:ring-slate-900" />
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
                <h4 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">
                  {edu.degree}
                </h4>
                <span class="inline-flex items-center self-start sm:self-auto rounded-md bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 dark:bg-emerald-950/70 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-900/50">
                  {edu.year}
                </span>
              </div>
              <p class="mt-0.5 text-sm font-semibold text-emerald-600 dark:text-emerald-400">
                {edu.institution}
              </p>
              {
                edu.description && (
                  <p class="mt-2.5 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
                    {edu.description}
                  </p>
                )
              }
            </div>
          ))
        }
      </div>
    </div>

    <!-- 5. Core Technical Competencies & Skills -->
    {
      (skillCategories.length > 0 || (data.skills && data.skills.length > 0)) && (
        <div class="rounded-2xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-xs dark:border-slate-800/90 dark:bg-slate-900/80 transition-colors">
          <div class="flex items-center gap-3 border-b border-slate-100 pb-4 dark:border-slate-800/60">
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-amber-50 text-amber-600 dark:bg-amber-950/70 dark:text-amber-400">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
                Core Technical Skills & Stack
              </h3>
              <p class="text-xs text-slate-500 dark:text-slate-400">
                Categorized technical stack, engineering tools, and frameworks.
              </p>
            </div>
          </div>

          {skillCategories.length > 0 ? (
            <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-5">
              {skillCategories.map((cat) => (
                <div class="rounded-xl border border-slate-200/80 bg-slate-50/60 p-4.5 dark:border-slate-800/80 dark:bg-slate-800/40">
                  <h4 class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-3 flex items-center gap-2">
                    <span class="h-1.5 w-1.5 rounded-full bg-blue-600 dark:bg-blue-400"></span>
                    <span>{cat.category}</span>
                  </h4>
                  <div class="flex flex-wrap gap-1.5">
                    {cat.skills.map((skill) => (
                      <span class="inline-flex items-center rounded-md bg-white px-2.5 py-1 text-xs font-medium text-slate-800 shadow-2xs border border-slate-200/80 dark:bg-slate-900 dark:text-slate-200 dark:border-slate-700/80">
                        {skill}
                      </span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div class="mt-6 flex flex-wrap gap-2">
              {data.skills.map((skill) => (
                <span class="inline-flex items-center rounded-md bg-white px-3 py-1.5 text-xs font-medium text-slate-800 shadow-2xs border border-slate-200/80 dark:bg-slate-900 dark:text-slate-200 dark:border-slate-700/80">
                  {skill}
                </span>
              ))}
            </div>
          )}
        </div>
      )
    }

    <!-- 6. Research Foci & Scientific Interests -->
    {
      data.researchAreas && data.researchAreas.length > 0 && (
        <div class="rounded-2xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-xs dark:border-slate-800/90 dark:bg-slate-900/80 transition-colors">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-slate-100 pb-4 dark:border-slate-800/60">
            <div class="flex items-center gap-3">
              <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-purple-50 text-purple-600 dark:bg-purple-950/70 dark:text-purple-400">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
                  Research Interests & Scholarly Foci
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                  Active scientific inquiries and publication domains.
                </p>
              </div>
            </div>

            <a
              href="/research"
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 transition-colors print:hidden"
            >
              <span>View Publications</span>
              <span>&rarr;</span>
            </a>
          </div>

          <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
            {data.researchAreas.map((area) => (
              <div class="flex items-start gap-3 rounded-xl border border-slate-200/80 bg-slate-50/50 p-3.5 dark:border-slate-800/80 dark:bg-slate-800/30">
                <div class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-md bg-purple-100 text-purple-700 dark:bg-purple-950 dark:text-purple-300">
                  <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <span class="text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200">
                  {area}
                </span>
              </div>
            ))}
          </div>
        </div>
      )
    }

    <!-- 7. Honors, Awards & Academic Scholarships -->
    {
      honorsAndAwards.length > 0 && (
        <div class="rounded-2xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-xs dark:border-slate-800/90 dark:bg-slate-900/80 transition-colors">
          <div class="flex items-center gap-3 border-b border-slate-100 pb-4 dark:border-slate-800/60">
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-rose-50 text-rose-600 dark:bg-rose-950/70 dark:text-rose-400">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
                Honors, Scholarships & Awards
              </h3>
              <p class="text-xs text-slate-500 dark:text-slate-400">
                Academic fellowships and professional recognitions.
              </p>
            </div>
          </div>

          <div class="mt-6 space-y-4">
            {honorsAndAwards.map((item) => (
              <div class="rounded-xl border border-slate-200/80 bg-slate-50/50 p-4 dark:border-slate-800/80 dark:bg-slate-800/30">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
                  <h4 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white">
                    {item.title}
                  </h4>
                  <span class="rounded bg-rose-50 px-2 py-0.5 text-xs font-semibold text-rose-700 dark:bg-rose-950/70 dark:text-rose-300 border border-rose-200/60 dark:border-rose-900/50 self-start sm:self-auto">
                    {item.year}
                  </span>
                </div>
                <p class="mt-0.5 text-xs font-semibold text-rose-600 dark:text-rose-400">
                  {item.organization}
                </p>
                {item.description && (
                  <p class="mt-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
                    {item.description}
                  </p>
                )}
              </div>
            ))}
          </div>
        </div>
      )
    }

    <!-- 8. Languages & Communication -->
    {
      languages.length > 0 && (
        <div class="rounded-2xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-xs dark:border-slate-800/90 dark:bg-slate-900/80 transition-colors">
          <div class="flex items-center gap-3 border-b border-slate-100 pb-4 dark:border-slate-800/60">
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-teal-50 text-teal-600 dark:bg-teal-950/70 dark:text-teal-400">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
                Languages & Communication
              </h3>
              <p class="text-xs text-slate-500 dark:text-slate-400">
                Linguistic proficiencies and communication abilities.
              </p>
            </div>
          </div>

          <div class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-4">
            {languages.map((lang) => (
              <div class="rounded-xl border border-slate-200/80 bg-slate-50/60 p-4 text-center dark:border-slate-800/80 dark:bg-slate-800/30">
                {lang.badge && (
                  <span class="inline-block rounded-md bg-teal-100 px-2 py-0.5 text-xs font-bold text-teal-800 dark:bg-teal-950 dark:text-teal-300">
                    {lang.badge}
                  </span>
                )}
                <h4 class="mt-2 text-base font-bold text-slate-900 dark:text-white">
                  {lang.language}
                </h4>
                <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
                  {lang.level}
                </p>
              </div>
            ))}
          </div>
        </div>
      )
    }
  </div>
</PageLayout>

<script>
  function setupPrintCv() {
    const btn = document.getElementById('print-cv-btn');
    if (btn) {
      btn.addEventListener('click', () => {
        window.print();
      });
    }
  }

  setupPrintCv();
  document.addEventListener('astro:after-swap', setupPrintCv);
</script>

<style>
  /* Print Optimization for Curriculum Vitae (PDF Export) */
  @media print {
    :global(header),
    :global(footer),
    :global(#theme-toggle-btn),
    :global(#print-cv-btn) {
      display: none !important;
    }

    .cv-container {
      margin: 0 !important;
      padding: 0 !important;
      box-shadow: none !important;
      border: none !important;
    }

    body {
      background: #ffffff !important;
      color: #0f172a !important;
    }
  }
</style>
