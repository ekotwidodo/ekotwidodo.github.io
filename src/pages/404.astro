---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';

/**
 * Custom 404 Page
 * User-friendly page with navigation options when route is not found.
 */
---

<BaseLayout title={`Page Not Found | ${siteConfig.name}`}>
  <div class="mx-auto flex min-h-[60vh] max-w-2xl flex-col items-center justify-center px-4 py-16 text-center">
    <div class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-primary-100 text-primary-600 dark:bg-primary-950 dark:text-primary-400">
      <span class="text-2xl font-black">404</span>
    </div>

    <h1 class="mt-6 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
      Page Not Found
    </h1>

    <p class="mt-3 text-base text-slate-600 dark:text-slate-400">
      The page or article you are looking for does not exist or has been relocated.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/"
        class="inline-flex h-10 items-center justify-center rounded-lg bg-primary-600 px-5 text-sm font-semibold text-white shadow-xs transition hover:bg-primary-700 dark:hover:bg-primary-500"
      >
        Return to Home
      </a>
      <a
        href="/archives"
        class="inline-flex h-10 items-center justify-center rounded-lg border border-slate-300 bg-white px-5 text-sm font-semibold text-slate-700 shadow-xs transition hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800"
      >
        Search Archives
      </a>
    </div>
  </div>
</BaseLayout>
