---
import FeaturedArticleCard from "@/components/article/FeaturedArticleCard.astro";
import type { ArticleEntry } from "@/utils/content";

/**
 * FeaturedArticlesCarousel Component
 * Responsive horizontal sliding carousel for featured articles.
 * Features:
 * - Flanking Left ("before") and Right ("next") navigation arrows
 * - Touch swipe & smooth snap scrolling
 * - Real-time slide counter and dot pagination
 * - Responsive: 1 card on mobile, 2 on tablet, 3 on desktop
 */
interface Props {
  articles: ArticleEntry[];
  title?: string;
  subtitle?: string;
  className?: string;
}

const {
  articles,
  title = "Featured Articles",
  subtitle = "Curated in-depth guides, practical workflows, and series highlights.",
  className = "",
} = Astro.props;

// Strictly cap at a maximum of 5 featured articles
const displayArticles = articles.slice(0, 5);
---

<div
  class={`relative ${className}`}
  role="region"
  aria-roledescription="carousel"
  aria-label={title}
>
  <!-- Section Header with Title & Article Counter Badge -->
  <div
    class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-slate-200/80 pb-4 dark:border-slate-800/80"
  >
    <div>
      <h2 class="heading-section text-slate-900 dark:text-white">
        {title}
      </h2>

      <p class="subtitle-section text-slate-600 dark:text-slate-400 mt-1">
        {subtitle}
      </p>
    </div>

    <!-- Article indicator badge & quick hint -->
    {
      displayArticles.length > 1 && (
        <div class="flex items-center gap-3 self-start sm:self-auto shrink-0">
          <div
            id="carousel-counter-badge"
            class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1 text-xs font-mono font-semibold text-slate-700 dark:bg-slate-800/90 dark:text-slate-300 border border-slate-200/70 dark:border-slate-700/60 select-none shadow-2xs"
            aria-live="polite"
          >
            <span class="text-slate-400 dark:text-slate-500">Article</span>
            <span
              id="carousel-current-index"
              class="text-blue-600 dark:text-blue-400 font-bold"
            >
              1
            </span>
            <span class="text-slate-400 dark:text-slate-500">/</span>
            <span>{displayArticles.length}</span>
          </div>
        </div>
      )
    }
  </div>

  <!-- Carousel Viewport & Horizontal Track with Flanking Left & Right Arrows -->
  <div class="relative mt-6 group/carousel">
    {
      displayArticles.length > 1 && (
        <button
          type="button"
          id="featured-carousel-prev"
          class="absolute left-1 sm:-left-4 lg:-left-5 top-1/2 -translate-y-1/2 z-20 flex h-11 w-11 sm:h-12 sm:w-12 items-center justify-center rounded-full border border-slate-200/90 bg-white/95 text-slate-700 shadow-md backdrop-blur-sm transition-all duration-200 hover:scale-110 hover:bg-white hover:text-blue-600 hover:border-slate-300 hover:shadow-lg active:scale-95 disabled:opacity-0 disabled:pointer-events-none dark:border-slate-700 dark:bg-slate-800/95 dark:text-slate-200 dark:hover:bg-slate-800 dark:hover:text-blue-400 cursor-pointer"
          aria-label="Previous articles"
          title="Previous article"
        >
          <svg
            class="h-5 w-5 -translate-x-0.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M15 19l-7-7 7-7"
            />
          </svg>
        </button>
      )
    }

    <!-- Carousel Viewport & Horizontal Track -->
    <div
      id="featured-carousel-track"
      class="flex gap-6 overflow-x-auto scroll-smooth pb-4 pt-1 px-1 snap-x snap-mandatory [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
      tabindex="0"
      aria-label="Featured Articles Slider Track"
    >
      {
        displayArticles.map((article, index) => (
          <div
            class="carousel-card-item w-[85%] sm:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] shrink-0 snap-start flex"
            data-index={index}
          >
            <FeaturedArticleCard
              article={article}
              className="w-full flex-1 flex flex-col"
            />
          </div>
        ))
      }
    </div>

    {
      displayArticles.length > 1 && (
        <button
          type="button"
          id="featured-carousel-next"
          class="absolute right-1 sm:-right-4 lg:-right-6 top-1/2 -translate-y-1/2 z-20 flex h-11 w-11 sm:h-12 sm:w-12 items-center justify-center rounded-full border border-slate-200/90 bg-white/95 text-slate-700 shadow-md backdrop-blur-sm transition-all duration-200 hover:scale-110 hover:bg-white hover:text-blue-600 hover:border-slate-300 hover:shadow-lg active:scale-95 disabled:opacity-0 disabled:pointer-events-none dark:border-slate-700 dark:bg-slate-800/95 dark:text-slate-200 dark:hover:bg-slate-800 dark:hover:text-blue-400 cursor-pointer"
          aria-label="Next articles"
          title="Next article"
        >
          <svg
            class="h-5 w-5 translate-x-0.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M9 5l7 7-7 7"
            />
          </svg>
        </button>
      )
    }
  </div>

  <!-- Bottom Dots Navigation Indicator -->
  {
    displayArticles.length > 1 && (
      <div
        class="mt-4 flex items-center justify-center gap-1.5"
        id="carousel-dots-container"
        aria-label="Slider navigation dots"
      >
        {displayArticles.map((_, index) => (
          <button
            type="button"
            class={`carousel-dot h-2 rounded-full transition-all duration-300 cursor-pointer ${index === 0 ? "w-6 bg-blue-600 dark:bg-blue-400" : "w-2 bg-slate-300 hover:bg-slate-400 dark:bg-slate-700 dark:hover:bg-slate-600"}`}
            data-target-index={index}
            aria-label={`Jump to article ${index + 1}`}
            title={`Article ${index + 1}`}
          />
        ))}
      </div>
    )
  }
</div>

<script>
  function setupFeaturedCarousel() {
    const track = document.getElementById("featured-carousel-track");
    const prevBtn = document.getElementById(
      "featured-carousel-prev",
    ) as HTMLButtonElement | null;
    const nextBtn = document.getElementById(
      "featured-carousel-next",
    ) as HTMLButtonElement | null;
    const currentIndexEl = document.getElementById("carousel-current-index");
    const dots = document.querySelectorAll(".carousel-dot");

    if (!track) return;

    const cards = track.querySelectorAll(".carousel-card-item");
    const totalCards = cards.length;
    if (totalCards <= 1) return;

    const getScrollStep = () => {
      const firstCard = cards[0] as HTMLElement | undefined;
      if (firstCard) {
        return firstCard.offsetWidth + 24; // Card width + gap (gap-6 = 24px)
      }
      return track.clientWidth * 0.8;
    };

    const updateControls = () => {
      const scrollLeft = track.scrollLeft;
      const maxScroll = track.scrollWidth - track.clientWidth;
      const isAtStart = scrollLeft <= 15;
      const isAtEnd = scrollLeft >= maxScroll - 15;

      if (prevBtn) prevBtn.disabled = isAtStart;
      if (nextBtn) nextBtn.disabled = isAtEnd;

      const step = getScrollStep();
      const activeIdx = Math.min(
        totalCards - 1,
        Math.max(0, Math.round(scrollLeft / step)),
      );

      if (currentIndexEl) {
        currentIndexEl.textContent = String(activeIdx + 1);
      }

      dots.forEach((dot, idx) => {
        if (idx === activeIdx) {
          dot.className =
            "carousel-dot h-2 rounded-full transition-all duration-300 cursor-pointer w-6 bg-blue-600 dark:bg-blue-400";
        } else {
          dot.className =
            "carousel-dot h-2 rounded-full transition-all duration-300 cursor-pointer w-2 bg-slate-300 hover:bg-slate-400 dark:bg-slate-700 dark:hover:bg-slate-600";
        }
      });
    };

    const handlePrev = () => {
      track.scrollBy({
        left: -getScrollStep(),
        behavior: "smooth",
      });
    };

    const handleNext = () => {
      track.scrollBy({
        left: getScrollStep(),
        behavior: "smooth",
      });
    };

    prevBtn?.addEventListener("click", handlePrev);
    nextBtn?.addEventListener("click", handleNext);
    track.addEventListener("scroll", updateControls, { passive: true });

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const targetIndex = Number(dot.getAttribute("data-target-index"));
        const targetCard = cards[targetIndex] as HTMLElement | undefined;
        if (targetCard) {
          track.scrollTo({
            left: targetCard.offsetLeft - track.offsetLeft,
            behavior: "smooth",
          });
        }
      });
    });

    // Keyboard navigation when track is focused
    track.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") {
        handlePrev();
        e.preventDefault();
      } else if (e.key === "ArrowRight") {
        handleNext();
        e.preventDefault();
      }
    });

    // Initial state
    updateControls();
  }

  setupFeaturedCarousel();
  document.addEventListener("astro:after-swap", setupFeaturedCarousel);
</script>
