---
import { formatDate } from '@/utils/date';
import { calculateReadingTime } from '@/utils/readingTime';
import Badge from '@/components/common/Badge.astro';
import type { ArticleEntry } from '@/utils/content';

/**
  * FeaturedArticleCard Component
  * Prominent, premium card layout for curated spotlight articles on the Home page.
  */
interface Props {
  article: ArticleEntry;
  className?: string;
  isSpotlight?: boolean;
}

const { article, className = '', isSpotlight = false } = Astro.props;
const readingTime = calculateReadingTime(article.body || '');
const formattedDate = formatDate(article.data.date);
const articleUrl = `/articles/${article.id.replace(/\.(md|mdx)$/, '')}`;
const imageSrc = article.data.image || '/assets/img/articles/understanding-rdf-and-turtle.jpg';

function getCategoryColor(category: string): 'purple' | 'indigo' | 'emerald' | 'amber' | 'teal' | 'info' | 'primary' {
  const cat = category.toLowerCase();
  if (cat.includes('artificial') || cat.includes('ai')) return 'purple';
  if (cat.includes('knowledge')) return 'indigo';
  if (cat.includes('data')) return 'emerald';
  if (cat.includes('software') || cat.includes('testing')) return 'amber';
  if (cat.includes('semantic')) return 'teal';
  if (cat.includes('web')) return 'info';
  return 'primary';
}

const categoryVariant = getCategoryColor(article.data.category);
---

<article
  class={`group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-slate-200/90 bg-white transition-all duration-300 hover:-translate-y-1 hover:border-blue-400/80 hover:shadow-lg hover:shadow-blue-500/5 dark:border-slate-800 dark:bg-slate-900/90 dark:hover:border-blue-500/60 dark:hover:shadow-blue-900/10 ${className}`}
>
  <!-- Top Image Banner -->
  <div class="relative aspect-16/9 w-full overflow-hidden bg-slate-100 dark:bg-slate-800 border-b border-slate-100 dark:border-slate-800/80">
    <img
      src={imageSrc}
      alt={article.data.title}
      class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-104"
      loading="lazy"
    />
    
    <!-- Top-Left Floating Badges -->
    <div class="absolute top-3 left-3 flex flex-wrap items-center gap-2">
      <!-- Featured Star Pill -->
      <span class="inline-flex items-center gap-1 rounded-full bg-amber-500/90 px-2.5 py-0.5 text-[11px] font-bold text-white shadow-xs backdrop-blur-md">
        <svg class="h-3 w-3 fill-current" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        <span>Featured</span>
      </span>

      <!-- Category Pill -->
      <Badge variant={categoryVariant} size="sm">
        {article.data.category}
      </Badge>
    </div>

    <!-- Top-Right Series Badge (if in series) -->
    {
      article.data.series && (
        <div class="absolute top-3 right-3">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-900/80 px-2.5 py-0.5 text-[11px] font-medium text-amber-300 shadow-xs backdrop-blur-md border border-amber-400/30">
            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
            </svg>
            <span>Part {article.data.series.part}</span>
          </span>
        </div>
      )
    }
  </div>

  <!-- Content Body -->
  <div class="flex flex-1 flex-col justify-between p-5 sm:p-6">
    <div>
      <!-- Series Header Label (if applicable) -->
      {
        article.data.series && (
          <div class="mb-2 flex items-center gap-1.5 text-xs font-semibold text-amber-700 dark:text-amber-400 font-mono">
            <span>Series: {article.data.series.name}</span>
          </div>
        )
      }

      <!-- Title with Link -->
      <h3 class="text-lg sm:text-xl font-bold tracking-tight text-slate-900 transition-colors group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400 leading-snug">
        <a href={articleUrl} class="focus:outline-none">
          <span class="absolute inset-0" aria-hidden="true" />
          {article.data.title}
        </a>
      </h3>

      <!-- Summary -->
      <p class="mt-2.5 text-sm leading-relaxed text-slate-600 line-clamp-3 dark:text-slate-300">
        {article.data.summary}
      </p>
    </div>

    <!-- Bottom Footer Meta Row -->
    <div class="mt-5 flex items-center justify-between border-t border-slate-100 pt-3 text-xs text-slate-500 dark:border-slate-800 dark:text-slate-400 font-mono">
      <div class="flex items-center gap-2">
        <time datetime={article.data.date.toISOString()}>
          {formattedDate}
        </time>
        <span>&bull;</span>
        <span>{readingTime}</span>
      </div>

      <span class="inline-flex items-center gap-1 font-semibold text-blue-600 dark:text-blue-400 group-hover:translate-x-0.5 transition-transform">
        <span>Read &rarr;</span>
      </span>
    </div>
  </div>
</article>
