---
import type { SeriesNavigationInfo } from '@/utils/content';

/**
 * SeriesWidget Component
 * Displays a curated series banner and parts checklist for articles that belong to a series.
 */
interface Props {
  seriesNav: SeriesNavigationInfo;
  className?: string;
}

const { seriesNav, className = '' } = Astro.props;
---

<div
  class={`my-6 sm:my-8 overflow-hidden rounded-xl border border-amber-200/90 bg-amber-50/40 p-4 sm:p-5 dark:border-amber-900/60 dark:bg-amber-950/20 shadow-2xs ${className}`}
>
  <!-- Series Header Row -->
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-amber-200/60 pb-3 dark:border-amber-900/50">
    <div class="flex items-center gap-2.5">
      <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-amber-500 text-white shadow-xs">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
        </svg>
      </div>

      <div>
        <span class="text-[11px] font-bold uppercase tracking-wider text-amber-800 dark:text-amber-400 font-mono">
          Article Series
        </span>
        <h4 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white leading-tight">
          {seriesNav.seriesName}
        </h4>
      </div>
    </div>

    <!-- Part Badge -->
    <span class="inline-flex items-center rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-900 dark:bg-amber-900/60 dark:text-amber-200 border border-amber-300/80 dark:border-amber-700/60 font-mono">
      Part {seriesNav.currentPart} of {seriesNav.totalParts}
    </span>
  </div>

  <!-- Parts List Navigation -->
  <div class="mt-3.5 space-y-1.5">
    <p class="text-xs font-medium text-slate-600 dark:text-slate-400">
      This article is part of an ongoing multi-part series:
    </p>

    <ol class="space-y-1.5 pt-1 text-xs">
      {
        seriesNav.allParts.map((item) => {
          const isCurrent = item.data.series?.part === seriesNav.currentPart;
          const partNumber = item.data.series?.part ?? 1;
          const articleUrl = `/articles/${item.id.replace(/\.(md|mdx)$/, '')}`;

          return (
            <li class="flex items-center">
              {isCurrent ? (
                <div class="flex w-full items-center justify-between gap-2 rounded-lg bg-white px-3 py-2 font-medium text-blue-900 ring-1 ring-blue-500/30 dark:bg-slate-900 dark:text-blue-300 shadow-2xs">
                  <div class="flex items-center gap-2 truncate">
                    <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-blue-600 text-[10px] font-bold text-white">
                      {partNumber}
                    </span>
                    <span class="truncate font-semibold">{item.data.title}</span>
                  </div>
                  <span class="shrink-0 rounded-md bg-blue-50 px-2 py-0.5 text-[10px] font-bold text-blue-700 dark:bg-blue-950 dark:text-blue-300">
                    Current Part
                  </span>
                </div>
              ) : (
                <a
                  href={articleUrl}
                  class="group flex w-full items-center justify-between gap-2 rounded-lg px-3 py-1.5 text-slate-700 transition-colors hover:bg-amber-100/60 dark:text-slate-300 dark:hover:bg-amber-900/30"
                >
                  <div class="flex items-center gap-2 truncate">
                    <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-slate-200 text-[10px] font-semibold text-slate-700 group-hover:bg-amber-500 group-hover:text-white dark:bg-slate-800 dark:text-slate-300 transition-colors">
                      {partNumber}
                    </span>
                    <span class="truncate group-hover:text-blue-600 dark:group-hover:text-blue-400">{item.data.title}</span>
                  </div>
                  <span class="shrink-0 text-[11px] font-medium text-slate-400 group-hover:text-blue-600 dark:group-hover:text-blue-400">
                    Read &rarr;
                  </span>
                </a>
              )}
            </li>
          );
        })
      }
    </ol>
  </div>
</div>
