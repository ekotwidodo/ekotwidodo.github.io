---
import Badge from '@/components/common/Badge.astro';
import type { ResearchEntry } from '@/utils/content';

/**
 * ResearchCard Component
 * Displays academic papers, theses, and publications with status, DOI, and keywords
 * with a multi-color harmonious palette.
 */
interface Props {
  item: ResearchEntry;
  className?: string;
}

const { item, className = '' } = Astro.props;
const data = item.data;
const isCompleted = data.status === 'completed';
---

<article
  class={`group relative overflow-hidden rounded-xl border border-slate-200/90 bg-white p-6 shadow-2xs transition-colors duration-200 hover:border-slate-400 hover:bg-slate-50/40 dark:border-slate-800/90 dark:bg-slate-900/90 dark:hover:border-slate-600 dark:hover:bg-slate-900 ${className}`}
>

  <!-- Top Meta: Year, Type, Status -->
  <div class="flex flex-wrap items-center justify-between gap-2">
    <div class="flex items-center gap-2">
      <span class="rounded-md bg-indigo-50 px-2.5 py-0.5 text-xs font-bold text-indigo-700 dark:bg-indigo-950/60 dark:text-indigo-300">
        {data.year}
      </span>
      {
        data.venue && (
          <span class="text-xs font-medium text-slate-500 dark:text-slate-400 line-clamp-1">
            {data.venue}
          </span>
        )
      }
    </div>

    <!-- Status Badge -->
    <Badge variant={isCompleted ? 'success' : 'warning'} size="sm">
      <span class="h-1.5 w-1.5 rounded-full bg-current" />
      <span class="capitalize">{data.status}</span>
    </Badge>
  </div>

  <!-- Title -->
  <h3 class="mt-3 text-lg font-bold text-slate-900 group-hover:text-indigo-600 transition-colors sm:text-xl dark:text-white dark:group-hover:text-indigo-400">
    {data.title}
  </h3>

  <!-- Abstract / Description -->
  <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
    {data.abstract}
  </p>

  <!-- Keywords with alternating colorful tags -->
  {
    data.keywords && data.keywords.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5">
        {data.keywords.map((kw, idx) => {
          const variants = ['teal', 'purple', 'indigo', 'neutral'] as const;
          const v = variants[idx % variants.length];
          return (
            <Badge variant={v} size="sm">
              {kw}
            </Badge>
          );
        })}
      </div>
    )
  }

  <!-- Footer Actions: DOI & Publication Links -->
  {
    (data.doi || data.url) && (
      <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-3 text-xs dark:border-slate-800/60">
        <div class="text-slate-500 dark:text-slate-400">
          {data.doi && (
            <span>
              DOI: <code class="font-mono text-slate-700 dark:text-slate-300">{data.doi}</code>
            </span>
          )}
        </div>

        {data.url && (
          <a
            href={data.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 font-semibold text-indigo-600 hover:text-indigo-700 dark:text-indigo-400 dark:hover:text-indigo-300 transition-colors"
          >
            <span>View Publication</span>
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        )}
      </div>
    )
  }
</article>
