---
import { siteConfig } from "@/config/site";
import { mainNavItems } from "@/config/navigation";

/**
 * Global Site Footer
 * Harmonious slate-navy footer grounding the layout with distinct contrast,
 * academic profiles, navigation links, and RSS feed indicator.
 */
const currentYear = new Date().getFullYear();
const socials = siteConfig.author.socials;
---

<footer
  class="mt-10 sm:mt-14 border-t border-slate-200/90 bg-white text-slate-600 transition-colors dark:border-slate-800/80 dark:bg-slate-900 dark:text-slate-400"
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-12 lg:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-4">
      <!-- Col 1: Bio & Brand -->
      <div class="md:col-span-2 space-y-3.5">
        <div class="flex items-center gap-3">
          <div
            class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white ring-1 ring-slate-200/90 dark:ring-slate-700/80 shadow-xs overflow-hidden"
          >
            <img
              src={siteConfig.logo || "/logo.png"}
              alt={siteConfig.short_name || siteConfig.name}
              class="h-full w-full object-contain p-0.5"
              width="32"
              height="32"
              loading="lazy"
            />
          </div>
          <div>
            <span class="text-base font-bold text-slate-900 dark:text-white">
              {siteConfig.author.name}
            </span>
            <p class="text-xs text-blue-600 dark:text-blue-400 font-medium">
              {siteConfig.tagline || siteConfig.author.title}
            </p>
          </div>
        </div>

        <p
          class="text-sm leading-relaxed text-slate-500 dark:text-slate-400 max-w-md"
        >
          {siteConfig.subtitle || siteConfig.description}
        </p>

        <div class="pt-2">
          <a
            href="/rss.xml"
            class="inline-flex items-center gap-1.5 rounded-lg border border-amber-500/30 bg-amber-500/10 px-3 py-1.5 text-xs font-semibold text-amber-700 transition hover:bg-amber-500/20 hover:text-amber-800 dark:border-amber-400/30 dark:bg-amber-400/10 dark:text-amber-400 dark:hover:bg-amber-400/20"
            title="Subscribe to RSS Feed"
          >
            <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"
              ></path>
            </svg>
            <span>Subscribe via RSS</span>
          </a>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div>
        <h3
          class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white"
        >
          Navigation
        </h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            mainNavItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-slate-600 hover:text-blue-600 transition-colors dark:text-slate-400 dark:hover:text-blue-400"
                >
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 3: Profiles & Social (Logo Only / Simpel) -->
      <div>
        <h3
          class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white"
        >
          Profiles & Social
        </h3>
        <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">
          Connect across academic and developer platforms:
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-2">
          {
            socials.linkedin && (
              <a
                href={socials.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 shadow-2xs transition hover:border-blue-600 hover:bg-blue-600 hover:text-white dark:border-slate-800 dark:bg-slate-800/80 dark:text-slate-300 dark:hover:border-blue-600 dark:hover:bg-blue-600 dark:hover:text-white"
                title="LinkedIn"
                aria-label="LinkedIn"
              >
                <svg
                  class="h-4.5 w-4.5"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.64 1.64 0 1 0 0-3.28 1.64 1.64 0 0 0 0 3.28m1.4 9.74v-8.37H5.06v8.37h2.8z" />
                </svg>
              </a>
            )
          }

          {
            socials.github && (
              <a
                href={socials.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 shadow-2xs transition hover:border-slate-800 hover:bg-slate-900 hover:text-white dark:border-slate-800 dark:bg-slate-800/80 dark:text-slate-300 dark:hover:border-slate-600 dark:hover:bg-white dark:hover:text-slate-900"
                title="GitHub"
                aria-label="GitHub"
              >
                <svg
                  class="h-4.5 w-4.5"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    fill-rule="evenodd"
                    clip-rule="evenodd"
                    d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                  />
                </svg>
              </a>
            )
          }

          {
            socials.medium && (
              <a
                href={socials.medium}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 shadow-2xs transition hover:border-slate-800 hover:bg-slate-900 hover:text-white dark:border-slate-800 dark:bg-slate-800/80 dark:text-slate-300 dark:hover:border-slate-600 dark:hover:bg-white dark:hover:text-slate-900"
                title="Medium"
                aria-label="Medium"
              >
                <svg
                  class="h-4.5 w-4.5"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path d="M13.54 12a6.8 6.8 0 0 1-6.77 6.82A6.8 6.8 0 0 1 0 12a6.8 6.8 0 0 1 13.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z" />
                </svg>
              </a>
            )
          }

          {
            socials.instagram && (
              <a
                href={socials.instagram}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 shadow-2xs transition hover:border-rose-500 hover:bg-rose-50 hover:text-rose-600 dark:border-slate-800 dark:bg-slate-800/80 dark:text-slate-300 dark:hover:border-rose-500 dark:hover:bg-rose-950/60 dark:hover:text-rose-400"
                title="Instagram"
                aria-label="Instagram"
              >
                <svg
                  class="h-4.5 w-4.5"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                </svg>
              </a>
            )
          }

          {
            socials.x && (
              <a
                href={socials.x}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 shadow-2xs transition hover:border-slate-800 hover:bg-slate-900 hover:text-white dark:border-slate-800 dark:bg-slate-800/80 dark:text-slate-300 dark:hover:border-slate-600 dark:hover:bg-white dark:hover:text-slate-900"
                title="X / Twitter"
                aria-label="X / Twitter"
              >
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                </svg>
              </a>
            )
          }
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div
      class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-slate-200 dark:border-slate-800 pt-6 text-xs text-slate-500 dark:text-slate-400 sm:flex-row"
    >
      <p>
        &copy; {currentYear}
        {siteConfig.author.name}. All rights reserved.
      </p>
      <div class="flex items-center gap-2 font-mono text-xs">
        <span class="inline-flex items-center gap-1.5 rounded-md border border-slate-200/80 bg-slate-100/80 px-2.5 py-1 text-[11px] font-medium text-slate-600 dark:border-slate-800 dark:bg-slate-800/80 dark:text-slate-400">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
          <span>v{siteConfig.version || '1.1.0'}</span>
        </span>
      </div>
    </div>
  </div>
</footer>
