---
import type { BreadcrumbItem } from '@/types/navigation';

/**
 * Breadcrumbs Component (Standard Pakem)
 * Displays a clean navigation trail with semantic HTML and schema.org metadata.
 */
interface Props {
  items: BreadcrumbItem[];
  className?: string;
  isDark?: boolean;
}

const { items, className = '', isDark = false } = Astro.props;
---

<nav aria-label="Breadcrumb" class={`flex items-center text-xs font-medium ${isDark ? 'text-slate-300 dark:text-slate-600' : 'text-slate-500 dark:text-slate-400'} ${className}`}>
  <ol class="flex flex-wrap items-center gap-1.5 sm:gap-2">
    <li>
      <a
        href="/"
        class={`inline-flex items-center gap-1.5 rounded-md px-1.5 py-0.5 transition-colors ${
          isDark
            ? 'text-slate-300 hover:text-white dark:text-slate-600 dark:hover:text-slate-900'
            : 'hover:text-blue-600 hover:bg-slate-100/80 dark:hover:text-blue-400 dark:hover:bg-slate-900/60'
        }`}
      >
        <svg class="h-3.5 w-3.5 text-blue-600 dark:text-blue-400" viewBox="0 0 20 20" fill="currentColor">
          <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
        </svg>
        <span>Home</span>
      </a>
    </li>

    {
      items.map((item, index) => {
        const isLast = index === items.length - 1;
        return (
          <li class="flex items-center gap-1.5 sm:gap-2">
            <svg
              class={`h-3 w-3 ${isDark ? 'text-slate-500 dark:text-slate-400' : 'text-slate-400 dark:text-slate-600'}`}
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
            </svg>
            {item.href && !isLast ? (
              <a
                href={item.href}
                class={`rounded-md px-1.5 py-0.5 transition-colors ${
                  isDark
                    ? 'text-slate-300 hover:text-white dark:text-slate-600 dark:hover:text-slate-900'
                    : 'hover:text-blue-600 hover:bg-slate-100/80 dark:hover:text-blue-400 dark:hover:bg-slate-900/60'
                }`}
              >
                {item.name}
              </a>
            ) : (
              <span
                class={`font-semibold truncate max-w-[160px] sm:max-w-xs ${
                  isDark ? 'text-blue-400 dark:text-blue-600' : 'text-slate-900 dark:text-white'
                }`}
                aria-current="page"
              >
                {item.name}
              </span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
