---
/**
 * SectionHeader Component (Standard Pakem)
 * Provides unified title, description, and action button layouts across sections.
 */
interface Props {
  title: string;
  subtitle?: string;
  actionText?: string;
  actionHref?: string;
  className?: string;
}

const {
  title,
  subtitle,
  actionText,
  actionHref,
  className = ''
} = Astro.props;
---

<div class={`flex flex-col sm:flex-row sm:items-end justify-between gap-3 border-b border-slate-200/80 pb-4 dark:border-slate-800/80 ${className}`}>
  <div>
    <h2 class="heading-section text-slate-900 dark:text-white">
      {title}
    </h2>
    {
      subtitle && (
        <p class="subtitle-section text-slate-600 dark:text-slate-400 mt-1">
          {subtitle}
        </p>
      )
    }
  </div>

  {
    actionText && actionHref && (
      <a
        href={actionHref}
        class="inline-flex items-center gap-1 text-xs sm:text-sm font-semibold text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 transition-colors shrink-0"
      >
        <span>{actionText}</span>
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    )
  }
</div>
