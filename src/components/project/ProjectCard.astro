---
import Badge from '@/components/common/Badge.astro';
import type { ProjectEntry } from '@/utils/content';

/**
 * ProjectCard Component
 * Displays a portfolio project or showcase card with tech stack, role, and source links
 * with a harmonious multi-color tech stack badge system.
 */
interface Props {
  project: ProjectEntry;
  className?: string;
}

const { project, className = '' } = Astro.props;
const data = project.data;

/**
 * Maps technologies to rich color badges
 */
function getTechBadgeVariant(tech: string): 'emerald' | 'amber' | 'indigo' | 'teal' | 'info' | 'purple' | 'primary' {
  const t = tech.toLowerCase();
  if (t.includes('python') || t.includes('streamlit') || t.includes('pandas')) return 'emerald';
  if (t.includes('java') || t.includes('maven') || t.includes('restassured')) return 'amber';
  if (t.includes('node') || t.includes('php')) return 'indigo';
  if (t.includes('astro') || t.includes('html') || t.includes('tailwind')) return 'info';
  if (t.includes('api') || t.includes('mysql') || t.includes('rest')) return 'teal';
  if (t.includes('ai') || t.includes('ml')) return 'purple';
  return 'primary';
}
---

<article
  class={`group relative flex h-full flex-col justify-between overflow-hidden rounded-xl border border-slate-200/90 bg-white p-6 shadow-2xs transition-colors duration-200 hover:border-slate-400 hover:bg-slate-50/40 dark:border-slate-800/90 dark:bg-slate-900/90 dark:hover:border-slate-600 dark:hover:bg-slate-900 ${className}`}
>
  <div class="flex flex-1 flex-col">
    <!-- Header: Role & Status -->
    <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
      {
        data.role ? (
          <span class="font-medium text-slate-500 dark:text-slate-400">
            {data.role}
          </span>
        ) : (
          <span />
        )
      }

      <Badge
        variant={data.status === 'completed' ? 'success' : 'neutral'}
        size="sm"
      >
        <span class="capitalize">{data.status}</span>
      </Badge>
    </div>

    <!-- Title -->
    <h3 class="mt-3 text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors sm:text-xl dark:text-white dark:group-hover:text-blue-400">
      {data.title}
    </h3>

    <!-- Description -->
    <p class="mt-2.5 text-sm leading-relaxed text-slate-600 dark:text-slate-300 flex-1">
      {data.description}
    </p>

    <!-- Technologies with semantic colorful badges -->
    <div class="mt-5 flex flex-wrap gap-1.5 pt-1">
      {
        data.technologies.map((tech) => (
          <Badge variant={getTechBadgeVariant(tech)} size="sm">
            {tech}
          </Badge>
        ))
      }
    </div>
  </div>

  <!-- Links footer pinned to bottom with consistent height -->
  <div class="mt-6 flex min-h-[38px] flex-wrap items-center gap-4 border-t border-slate-100 pt-3.5 text-xs dark:border-slate-800/60">
    {data.demoUrl && (
      <a
        href={data.demoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 font-semibold text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 transition-colors"
      >
        <span>Live Demo</span>
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    )}

    {data.repoUrl && (
      <a
        href={data.repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 font-semibold text-slate-700 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white transition-colors"
      >
        <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        <span>Repository</span>
      </a>
    )}

    {!data.demoUrl && !data.repoUrl && (
      <span class="inline-flex items-center gap-1.5 text-slate-400 dark:text-slate-500 italic">
        Internal Institutional System
      </span>
    )}
  </div>
</article>
