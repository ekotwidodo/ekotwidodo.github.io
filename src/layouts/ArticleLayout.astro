---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Badge from '@/components/common/Badge.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import ShareButtons from '@/components/common/ShareButtons.astro';
import ArticleCard from '@/components/article/ArticleCard.astro';
import SeriesWidget from '@/components/article/SeriesWidget.astro';
import SeriesNavBottom from '@/components/article/SeriesNavBottom.astro';
import { formatDate } from '@/utils/date';
import { siteConfig } from '@/config/site';
import type { ArticleEntry, SeriesNavigationInfo } from '@/utils/content';

/**
 * ArticleLayout Component
 * Implements a clean, editorial Medium-style reading layout:
 * 1. Dominant Title (H1) and Subtitle/Summary.
 * 2. Dynamic Reading Progress Bar along the top of the article.
 * 3. Author byline row (Circular Avatar, Name, Follow badge, Reading time · Date).
 * 4. Featured Cover image banner.
 * 5. Article Series Widget (if article belongs to a series).
 * 6. Article prose content with uniform, readable typography.
 * 7. Tags & Bottom action bar (Icon-only share buttons).
 * 8. Series Next/Previous navigation and Related Articles showcase.
 */
interface Props {
  title: string;
  date: Date;
  summary: string;
  category: string;
  tags: string[];
  readingTime: string;
  image?: string;
  relatedArticles?: ArticleEntry[];
  seriesNav?: SeriesNavigationInfo;
}

const {
  title,
  date,
  summary,
  category,
  tags,
  readingTime,
  image,
  relatedArticles = [],
  seriesNav
} = Astro.props;

/**
 * Maps categories to rich distinct color palettes
 */
function getCategoryColor(category: string): 'purple' | 'indigo' | 'emerald' | 'amber' | 'teal' | 'info' | 'primary' {
  const cat = category.toLowerCase();
  if (cat.includes('artificial') || cat.includes('ai')) return 'purple';
  if (cat.includes('knowledge')) return 'indigo';
  if (cat.includes('data')) return 'emerald';
  if (cat.includes('software') || cat.includes('testing')) return 'amber';
  if (cat.includes('semantic')) return 'teal';
  if (cat.includes('web')) return 'info';
  return 'primary';
}

const categoryVariant = getCategoryColor(category);
const breadcrumbs = [
  { name: 'Archives', href: '/archives' },
  { name: category, href: `/archives?category=${encodeURIComponent(category)}` }
];
---

<BaseLayout title={`${title} | ${siteConfig.name}`} description={summary} image={image}>
  <!-- Sticky Reading Progress Bar (Fixed directly beneath top navbar) -->
  <div
    id="reading-progress-container"
    class="fixed top-16 left-0 right-0 z-40 h-[3px] w-full bg-slate-200/50 dark:bg-slate-800/50 pointer-events-none"
    aria-hidden="true"
  >
    <div
      id="reading-progress-bar"
      class="h-full w-0 bg-linear-to-r from-blue-600 via-indigo-600 to-purple-600 transition-all duration-75 ease-out shadow-xs shadow-blue-500/50"
      style="width: 0%;"
    />
  </div>

  <article class="mx-auto max-w-4xl lg:max-w-5xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8">
    <!-- Breadcrumb Navigation Trail (Standard Pakem) -->
    <div class="mb-4 sm:mb-6">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <!-- Header: Judul Besar & Subtitle/Summary (Gaya Editorial Medium) -->
    <header class="mb-5 sm:mb-7">
      <h1 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl md:text-4xl lg:text-5xl dark:text-white leading-[1.2] sm:leading-[1.18]">
        {title}
      </h1>

      {
        summary && (
          <p class="mt-3 sm:mt-4 text-sm sm:text-base md:text-lg lg:text-xl font-normal leading-relaxed text-slate-600 dark:text-slate-300">
            {summary}
          </p>
        )
      }

      <!-- Author Byline Row (Terstruktur & Rapi di Mobile Maupun Desktop) -->
      <div class="mt-5 sm:mt-6 flex items-start sm:items-center gap-3 sm:gap-3.5 border-y border-slate-200/70 sm:border-y-0 py-3 sm:py-0 dark:border-slate-800/70">
        <a href="/about" class="shrink-0 group">
          <img
            src={siteConfig.author.avatar}
            alt={siteConfig.author.name}
            class="h-10 w-10 sm:h-11 sm:w-11 rounded-full object-cover object-top ring-1 ring-slate-300 dark:ring-slate-700 shadow-2xs transition group-hover:ring-blue-500"
            width="44"
            height="44"
          />
        </a>

        <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-2.5 text-xs sm:text-sm">
          <!-- Author Name & Follow Action -->
          <div class="flex items-center gap-2">
            <a
              href="/about"
              class="font-semibold text-slate-900 hover:text-blue-600 dark:text-white dark:hover:text-blue-400 transition-colors"
            >
              {siteConfig.author.name}
            </a>

            <!-- Follow Button -->
            <a
              href="/about"
              class="inline-flex items-center rounded-full border border-slate-300 bg-white px-2 py-0.5 text-[11px] font-medium text-slate-700 shadow-2xs hover:border-slate-800 hover:text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-slate-500 dark:hover:text-white transition-colors"
            >
              Follow
            </a>
          </div>

          <span class="hidden sm:inline text-slate-300 dark:text-slate-700">&bull;</span>

          <!-- Reading Time, Date, and Category Badge -->
          <div class="flex flex-wrap items-center gap-1.5 sm:gap-2 text-slate-500 dark:text-slate-400 font-sans">
            <span>{readingTime}</span>

            <span class="text-slate-300 dark:text-slate-700">&bull;</span>

            <time datetime={date.toISOString()}>
              {formatDate(date)}
            </time>

            <span class="text-slate-300 dark:text-slate-700">&bull;</span>

            <Badge variant={categoryVariant} size="sm">
              {category}
            </Badge>
          </div>
        </div>
      </div>
    </header>

    <!-- Featured Cover Image Banner -->
    {
      image && (
        <div class="my-5 sm:my-7 overflow-hidden rounded-lg sm:rounded-xl border border-slate-200/90 bg-slate-100 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
          <img
            src={image}
            alt={title}
            class="h-auto w-full max-h-[300px] sm:max-h-[420px] md:max-h-[520px] object-cover"
            loading="eager"
          />
        </div>
      )
    }

    <!-- Article Series Widget (Top Checklist) -->
    {seriesNav && <SeriesWidget seriesNav={seriesNav} />}

    <!-- Markdown Content Body dengan Tipografi Editorial & Drop-Cap -->
    <div class="prose-content py-2 sm:py-4 text-base leading-relaxed text-slate-700 dark:text-slate-200">
      <slot />
    </div>

    <!-- Article Series Navigation (Bottom Prev/Next) -->
    {seriesNav && <SeriesNavBottom seriesNav={seriesNav} />}

    <!-- Bottom Action Divider Bar (Claps + Icon-Only Share Buttons) -->
    <div class="my-8 flex flex-wrap items-center justify-between gap-3 border-y border-slate-200/90 py-2.5 dark:border-slate-800/90">
      <!-- Claps -->
      <button
        type="button"
        class="article-clap-btn inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-mono text-slate-600 hover:bg-slate-100 hover:text-rose-600 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-rose-400 transition cursor-pointer"
        data-clap-key={`clap_${title.replace(/\s+/g, '_').toLowerCase()}`}
        title="Applaud this article (Clap)"
      >
        <svg class="clap-icon h-4 w-4 text-rose-500 transition-transform active:scale-125" viewBox="0 0 24 24" fill="currentColor">
          <path d="M19 10.5V6a2 2 0 0 0-2-2c-.34 0-.66.08-.94.23A1.99 1.99 0 0 0 14.5 3c-.47 0-.91.16-1.26.44A2 2 0 0 0 11.5 3c-.76 0-1.42.42-1.76 1.05A1.99 1.99 0 0 0 8.5 4a2 2 0 0 0-2 2v8.5a7.5 7.5 0 1 0 15 0v-4h-2.5zm.5 4a5.5 5.5 0 1 1-11 0V6a.5.5 0 0 1 1 0v5.5h1.5V5a.5.5 0 0 1 1 0v6.5h1.5V4.5a.5.5 0 0 1 1 0v7h1.5V5.5a.5.5 0 0 1 1 0v6h1.5v-1a.5.5 0 0 1 1 0v4z"/>
        </svg>
        <span class="clap-count font-bold">0</span>
      </button>

      <!-- Icon-only Share Buttons -->
      <ShareButtons title={title} summary={summary} />
    </div>

    <!-- Tags Navigation -->
    <div class="mb-10 flex flex-wrap items-center gap-1.5 font-mono text-xs">
      <span class="mr-1 text-slate-500 dark:text-slate-400">Tags:</span>
      {
        tags.map((tag, idx) => {
          const tagVariants = ['neutral', 'teal', 'rose', 'indigo', 'amber'] as const;
          const variant = tagVariants[idx % tagVariants.length];
          return (
            <Badge variant={variant} size="sm" href={`/archives?tag=${encodeURIComponent(tag)}`}>
              #{tag}
            </Badge>
          );
        })
      }
    </div>

    <!-- Related Articles Section (Artikel Terkait) -->
    {
      relatedArticles && relatedArticles.length > 0 ? (
        <section class="mt-14 border-t border-slate-200/90 pt-10 dark:border-slate-800/90">
          <div class="mb-6 flex items-center justify-between">
            <div>
              <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
                Related Articles
              </h2>
              <p class="mt-1 text-xs sm:text-sm text-slate-500 dark:text-slate-400">
                More writings on {category} and related technologies.
              </p>
            </div>
            <a
              href="/archives"
              class="inline-flex items-center gap-1 text-xs font-semibold text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 transition-colors"
            >
              <span>All Articles</span>
              <span>&rarr;</span>
            </a>
          </div>

          <div class="flex flex-col gap-4 sm:gap-5">
            {relatedArticles.map((relArticle) => (
              <ArticleCard article={relArticle} />
            ))}
          </div>
        </section>
      ) : (
        <div class="mt-12 border-t border-slate-200/80 pt-8 text-center dark:border-slate-800/80">
          <a
            href="/archives"
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-600 hover:text-blue-600 dark:text-slate-400 dark:hover:text-blue-400 transition-colors"
          >
            <span>&larr; View All Articles in Archives</span>
          </a>
        </div>
      )
    }
  </article>
</BaseLayout>

<script>
  // Medium-style Clap counter interaction
  function setupClapButtons() {
    const clapButtons = document.querySelectorAll<HTMLButtonElement>('.article-clap-btn');
    if (clapButtons.length === 0) return;

    clapButtons.forEach((btn) => {
      const storageKey = btn.dataset.clapKey || 'article_claps';
      const countEl = btn.querySelector('.clap-count');
      const baseCount = 0; // default starting clap count

      let userClaps = parseInt(localStorage.getItem(storageKey) || '0', 10);
      if (countEl) {
        countEl.textContent = String(baseCount + userClaps);
      }

      if (btn.dataset.listenerAttached === 'true') return;
      btn.dataset.listenerAttached = 'true';

      btn.addEventListener('click', () => {
        userClaps += 1;
        localStorage.setItem(storageKey, String(userClaps));

        // Sync all clap buttons on the page
        clapButtons.forEach((b) => {
          const c = b.querySelector('.clap-count');
          if (c) c.textContent = String(baseCount + userClaps);
          const icon = b.querySelector('.clap-icon');
          if (icon) {
            icon.classList.add('scale-125');
            setTimeout(() => icon.classList.remove('scale-125'), 200);
          }
        });
      });
    });
  }

  // Copy Code Button functionality for article pre blocks
  function setupCodeBlockCopy() {
    const codeBlocks = document.querySelectorAll<HTMLPreElement>('.prose-content pre');
    codeBlocks.forEach((pre) => {
      if (pre.querySelector('.code-copy-btn')) return;

      pre.classList.add('relative', 'group');

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className =
        'code-copy-btn absolute top-2.5 right-2.5 sm:top-3 sm:right-3 inline-flex sm:hidden sm:group-hover:inline-flex items-center gap-1.5 rounded-md border border-slate-600 bg-slate-800/90 px-2 sm:px-2.5 py-1 text-[11px] font-sans font-medium text-slate-300 shadow-sm transition hover:bg-slate-700 hover:text-white dark:border-slate-700 dark:bg-slate-900/90 cursor-pointer';
      btn.setAttribute('aria-label', 'Copy code to clipboard');
      btn.innerHTML = `
        <svg class="h-3.5 w-3.5 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
        </svg>
        <span class="copy-text">Copy</span>
      `;

      btn.addEventListener('click', async () => {
        const code = pre.querySelector('code');
        const text = code ? code.innerText : pre.innerText;
        try {
          await navigator.clipboard.writeText(text);
          btn.innerHTML = `
            <svg class="h-3.5 w-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            <span class="text-emerald-400 font-semibold">Copied!</span>
          `;
          setTimeout(() => {
            btn.innerHTML = `
              <svg class="h-3.5 w-3.5 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
              <span class="copy-text">Copy</span>
            `;
          }, 2000);
        } catch {
          // fallback
        }
      });

      pre.appendChild(btn);
    });
  }

  // Wrap all markdown tables in a responsive scrolling container
  function setupResponsiveTables() {
    const tables = document.querySelectorAll<HTMLTableElement>('.prose-content table');
    tables.forEach((table) => {
      if (table.parentElement && !table.parentElement.classList.contains('table-container')) {
        const wrapper = document.createElement('div');
        wrapper.className = 'table-container overflow-x-auto my-4 sm:my-6 rounded-lg sm:rounded-xl border border-slate-200/90 bg-white shadow-2xs dark:border-slate-800 dark:bg-slate-900/60';
        table.parentNode?.insertBefore(wrapper, table);
        wrapper.appendChild(table);
      }
    });
  }

  // Reading Progress Bar: Smoothly fills from 0% to 100% as the reader scrolls down the article
  function setupReadingProgressBar() {
    const bar = document.getElementById('reading-progress-bar');
    const article = document.querySelector<HTMLElement>('article');
    if (!bar || !article) return;

    const updateProgress = () => {
      const articleRect = article.getBoundingClientRect();
      const articleTop = window.scrollY + articleRect.top;
      const articleHeight = article.offsetHeight;
      const windowHeight = window.innerHeight;
      const currentScroll = window.scrollY;

      const scrollableDistance = articleHeight - windowHeight;
      if (scrollableDistance <= 0) {
        bar.style.width = '100%';
        return;
      }

      const scrolled = currentScroll - articleTop;
      const percentage = Math.min(100, Math.max(0, Math.round((scrolled / scrollableDistance) * 100)));
      bar.style.width = `${percentage}%`;
    };

    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();
  }

  setupClapButtons();
  setupCodeBlockCopy();
  setupResponsiveTables();
  setupReadingProgressBar();
  document.addEventListener('astro:after-swap', () => {
    setupClapButtons();
    setupCodeBlockCopy();
    setupResponsiveTables();
    setupReadingProgressBar();
  });
</script>

<style is:global>
  /* Responsive Table Styling */
  .prose-content .table-container {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
    border-radius: 0.5rem;
    border: 1px solid #e2e8f0;
    background-color: #ffffff;
    box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.05);
  }
  @media (min-width: 640px) {
    .prose-content .table-container {
      margin-top: 2rem;
      margin-bottom: 2rem;
      border-radius: 0.75rem;
    }
  }
  .dark .prose-content .table-container {
    border-color: #334155;
    background-color: #0f172a;
    box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.2);
  }

  /* Self-contained styling for tables */
  .prose-content table {
    width: 100%;
    min-width: 480px;
    border-collapse: separate;
    border-spacing: 0;
    text-align: left;
    font-size: 0.8125rem;
    line-height: 1.55;
  }
  @media (min-width: 640px) {
    .prose-content table {
      min-width: 640px;
      font-size: 0.875rem;
      line-height: 1.6;
    }
  }

  .prose-content > table {
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
    border-radius: 0.5rem;
    border: 1px solid #e2e8f0;
    background-color: #ffffff;
    box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.05);
  }
  @media (min-width: 640px) {
    .prose-content > table {
      margin-top: 2rem;
      margin-bottom: 2rem;
      border-radius: 0.75rem;
    }
  }
  .dark .prose-content > table {
    border-color: #334155;
    background-color: #0f172a;
    box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.2);
  }

  .prose-content th {
    padding: 0.65rem 0.85rem !important;
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #0f172a;
    background-color: #f8fafc;
    border-bottom: 2px solid #cbd5e1;
    border-right: 1px solid #e2e8f0;
    white-space: nowrap;
  }
  @media (min-width: 640px) {
    .prose-content th {
      padding: 1rem 1.5rem !important;
      font-size: 0.8125rem;
    }
  }
  .prose-content th:last-child {
    border-right: none;
  }
  .dark .prose-content th {
    color: #f8fafc;
    background-color: #1e293b;
    border-bottom-color: #475569;
    border-right-color: #334155;
  }
  .dark .prose-content th:last-child {
    border-right: none;
  }

  .prose-content td {
    padding: 0.65rem 0.85rem !important;
    color: #334155;
    border-bottom: 1px solid #f1f5f9;
    border-right: 1px solid #f1f5f9;
    vertical-align: top;
  }
  @media (min-width: 640px) {
    .prose-content td {
      padding: 0.875rem 1.5rem !important;
    }
  }
  .prose-content td:last-child {
    border-right: none;
  }
  .dark .prose-content td {
    color: #cbd5e1;
    border-bottom-color: #1e293b;
    border-right-color: #1e293b;
  }
  .dark .prose-content td:last-child {
    border-right: none;
  }

  .prose-content tbody tr:last-child td {
    border-bottom: none;
  }

  .prose-content tbody tr:nth-child(even) {
    background-color: #f8fafc;
  }
  .dark .prose-content tbody tr:nth-child(even) {
    background-color: rgba(30, 41, 59, 0.4);
  }

  .prose-content tbody tr:hover {
    background-color: #f1f5f9;
  }
  .dark .prose-content tbody tr:hover {
    background-color: rgba(30, 41, 59, 0.75);
  }

  /* Clean, responsive article prose typography */
  .prose-content h2 {
    font-size: 1.35rem;
    font-weight: 700;
    margin-top: 1.75rem;
    margin-bottom: 0.65rem;
    color: var(--color-slate-900, #0f172a);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
  @media (min-width: 640px) {
    .prose-content h2 {
      font-size: 1.65rem;
      margin-top: 2.25rem;
      margin-bottom: 0.75rem;
    }
  }
  .dark .prose-content h2 {
    color: #f8fafc;
  }

  .prose-content h3 {
    font-size: 1.15rem;
    font-weight: 600;
    margin-top: 1.35rem;
    margin-bottom: 0.5rem;
    color: var(--color-slate-900, #0f172a);
    line-height: 1.35;
  }
  @media (min-width: 640px) {
    .prose-content h3 {
      font-size: 1.3rem;
      margin-top: 1.65rem;
    }
  }
  .dark .prose-content h3 {
    color: #f8fafc;
  }

  .prose-content p {
    margin-top: 1.1rem;
    margin-bottom: 1.1rem;
    line-height: 1.78;
    font-size: 0.96875rem;
  }
  @media (min-width: 640px) {
    .prose-content p {
      margin-top: 1.25rem;
      margin-bottom: 1.25rem;
      line-height: 1.85;
      font-size: 1rem;
    }
  }

  .prose-content ul,
  .prose-content ol {
    margin-top: 0.85rem;
    margin-bottom: 0.85rem;
    padding-left: 1.25rem;
  }
  @media (min-width: 640px) {
    .prose-content ul,
    .prose-content ol {
      margin-top: 1rem;
      margin-bottom: 1rem;
      padding-left: 1.5rem;
    }
  }
  .prose-content ul {
    list-style-type: disc;
  }
  .prose-content ol {
    list-style-type: decimal;
  }
  .prose-content li {
    margin-top: 0.35rem;
    margin-bottom: 0.35rem;
    line-height: 1.65;
  }

  /* Inline code styling */
  .prose-content :not(pre) > code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.85em;
    padding: 0.12rem 0.35rem;
    border-radius: 0.375rem;
    background-color: #f1f5f9;
    color: #0f172a;
    border: 1px solid #e2e8f0;
    word-break: break-word;
  }
  .dark .prose-content :not(pre) > code {
    background-color: #1e293b;
    color: #f8fafc;
    border-color: #334155;
  }

  /* Responsive Code Block Container */
  .prose-content pre {
    position: relative;
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
    padding: 2.25rem 1rem 0.875rem 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    font-size: 0.8125rem;
    line-height: 1.65;
    background-color: #1e293b !important;
    color: #e2e8f0;
    border: 1px solid #334155;
